+/// The identity a decision model id reads (TENSORFOLD_DECISION_IDS); null: the request names no decision id.
+pub fn decisionOf(config: Config, f: Value) ?u8 {
+    const m = f.get("model") orelse return null;
+    if (m != .string) return null;
+    for (config.decision_ids, config.decision_identities) |id, identity| if (std.mem.eql(u8, m.string, id)) return identity;
+    return null;
+}
+
+/// The identity a decision route reads: a decision id's, else the identity the model id names (identityOf).
+pub fn decisionIdentity(config: Config, f: Value) u8 {
+    return decisionOf(config, f) orelse identityOf(config, f);
+}
+
 /// The identity the request's model id names, 1..n of Config.identities; 0: the stock model.
