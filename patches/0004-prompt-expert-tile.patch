+/// TF_FLASHNEXT_PROMPT_EXPERT_TILE (unset: 2 at one rank, 0 at two) and _ROWS, the rows the K32 pipeline starts at.
+pub const Choice = struct { mode: cuda.experts_tile.Mode, rows: usize };
+
+pub fn choice(world: usize) !Choice {
+    const mode: cuda.experts_tile.Mode = if (std.c.getenv("TF_FLASHNEXT_PROMPT_EXPERT_TILE")) |v| try cuda.experts_tile.mode(std.mem.span(v)) else if (world == 1) .both else .off;
+    const rows = if (std.c.getenv("TF_FLASHNEXT_PROMPT_EXPERT_TILE_ROWS")) |v| std.fmt.parseInt(usize, std.mem.span(v), 10) catch 0 else 1024;
+    if (rows == 0) return error.BadPromptExpertTile;
+    return .{ .mode = mode, .rows = rows };
+}
+
+/// Passes of k.expert_tile_rows rows or more may take the K32 tile; decode calls the decode form in waves; same bits.
+pub fn run(k: anytype, n: usize, s: cuda.Stream, epi: cuda.experts.Epi, in: cuda.experts.Rows, l: cuda.experts.Layer, p: cuda.grouped.Plan, out: u64, items: usize, skip: i32) !void {
+    const pt = size(n);
+    if (pt != 16 and n >= k.expert_tile_rows) if (k.expert_tile) |*tile| if (tile.takes(epi)) return tile.run(s, epi, in, l, p, out, items, skip);
     const launch = if (pt == 16) &cuda.experts_waves.run else &cuda.experts.Nvfp4Experts.runFact;
     return launch(&k.nvfp4, s, epi, in, l, p, out, items, skip);
 }
