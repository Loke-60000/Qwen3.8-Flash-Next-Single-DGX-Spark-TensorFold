+    xs: u64,
+    inj: u64,
+    up: u64,
+    mixed: u64,
+    xsm: u64,
+    spart: u64,
+    rows: usize,
+
+    fn poison(c: *Chain) !void {
+        const d = c.r.gpu.d;
+        const bufs = [_][2]u64{ .{ c.part, c.rows * n_down * 4 }, .{ c.mixed, c.rows * dims * 2 }, .{ c.xsm, c.rows * (dims / 32) * 4 } };
+        for (bufs) |b| try (cuda.DeviceBuffer{ .d = d, .ptr = b[0], .len = b[1] }).fill8(0xff, c.r.s.handle);
+    }
+    fn native(c: *Chain, x: u64, ldx: usize, w: cuda.qmmf.Weight, y: u64, out: cuda.qmmf.Out) !void {
+        if (c.rows >= prompt_rows) return c.prompt.matmulOut(c.r.s, x, ldx, c.rows, w, y, out);
+        try c.lane.matmulOut(c.r.s, x, ldx, c.rows, w, y, out, c.spart);
+    }
+    fn baseNorm(c: *Chain) !void {
+        try c.g.hcNormalize(c.r.s, c.h, c.pss, c.scale, c.norm, eps, c.rows, dims, streams);
+    }
+    fn baseDown(c: *Chain) !void {
+        try c.native(c.norm, wide, c.wdown, c.part, .f32);
+    }
+    fn reduce(c: *Chain) !void {
+        try c.g.hcReduceAct(c.r.s, c.part, c.act, c.xs, c.inj, 1, c.rows, streams, low, n_down, 1);
+    }
+    fn baseUp(c: *Chain) !void {
+        try c.native(c.act, low, c.wup, c.up, .bf16);
+    }
+    fn baseMix(c: *Chain) !void {
+        try c.g.hcDenseMix(c.r.s, c.up, c.norm, c.mixed, c.xsm, c.rows, dims, streams);
+    }
+    fn newDown(c: *Chain, vi: usize) !void {
+        const mt = tk.hcn_down_mt[vi];
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.h, c.pss, c.scale, c.wdown.codes, c.part }) |v| a.add(v);
+        for ([_]usize{ c.rows, n_down, wide, cuda.qmmf.splitK(n_down, wide), dims, nc, streams }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const ctas = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_down[vi], .{ .grid = .{ .x = @intCast(ctas * 2) }, .block = .{ .x = 224 }, .shared = tk.hcnDownSmem(mt) }, c.r.s, &a);
+    }
+    fn newUp(c: *Chain) !void {
+        const mt = tk.hcn_up_mt;
+        var a: cuda.Args = .{};
+        for ([_]u64{ c.act, c.wup.codes, c.h, c.pss, c.scale, c.mixed, c.xsm }) |v| a.add(v);
+        for ([_]usize{ c.rows, dims, nc }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(eps);
+        const ctas = (c.rows + 16 * mt - 1) / (16 * mt);
+        try cuda.launch.launch(c.t.hcn_up, .{ .grid = .{ .x = @intCast(ctas * (dims / 32)) }, .block = .{ .x = 256 }, .shared = tk.hcnUpSmem(mt) }, c.r.s, &a);
+    }
+    fn base(c: *Chain) !void {
+        try c.baseNorm();
+        try c.baseDown();
+        try c.reduce();
+        try c.baseUp();
+        try c.baseMix();
+    }
+    fn fused(c: *Chain, di: usize) !void {
+        try c.newDown(di);
+        try c.reduce();
+        try c.newUp();
+    }
+};
+
+fn timeOf(c: *Chain, start: cuda.Event, end: cuda.Event, comptime f: anytype, args: anytype) !f64 {
+    const reps = 20;
+    try @call(.auto, f, .{c} ++ args);
+    try start.record(c.r.s);
+    for (0..reps) |_| try @call(.auto, f, .{c} ++ args);
+    try end.record(c.r.s);
+    try c.r.s.synchronize();
+    return @as(f64, try start.elapsedMs(end)) * 1000 / reps;
+}
+
+/// Mode 3 (the shared expert's output read in place) against mode 2 over a y whose last slot holds a copy of it, for the
+/// writeback and the writeback with the normalize.
+fn sharedDirect(r: *Rig, g: *const flash.Glue) !void {
+    const slots = 11;
+    for ([_]usize{ 1, 65, 1000 }) |m| {
+        const h = r.bfs(m * wide, 2);
+        const inj = r.bfs(m * streams, 2);
+        const y = r.f32s(m * slots * dims, -1, 1);
+        const shared = r.f32s(m * dims, -1, 1);
+        const wts = r.f32s(m * slots, 0, 0.3);
+        const scale = r.f32s(wide, 0.5, 1.5);
+        const y2 = try r.a.dupe(f32, y);
+        for (0..m) |row| @memcpy(y2[(row * slots + slots - 1) * dims ..][0..dims], shared[row * dims ..][0..dims]);
+        const dh = try r.dev(std.mem.sliceAsBytes(h));
+        const dinj = try r.dev(std.mem.sliceAsBytes(inj));
+        const dy = try r.dev(std.mem.sliceAsBytes(y));
+        const dy2 = try r.dev(std.mem.sliceAsBytes(y2));
+        const dsh = try r.dev(std.mem.sliceAsBytes(shared));
+        const dw = try r.dev(std.mem.sliceAsBytes(wts));
+        const dscale = try r.dev(std.mem.sliceAsBytes(scale));
+        const o2 = try r.out(m * wide * 2);
+        const o3 = try r.out(m * wide * 2);
+        const p2 = try r.out(m * nc * streams * 4);
+        const p3 = try r.out(m * nc * streams * 4);
+        const n2 = try r.out(m * wide * 2);
+        const n3 = try r.out(m * wide * 2);
+        try g.hcWriteback(r.s, dh, o2, p2, 0, dinj, dy2, dw, m * dims, m, dims, streams, 2, 10, 11, 1);
+        try g.hcWriteback(r.s, dh, o3, p3, dsh, dinj, dy, dw, m * dims, m, dims, streams, 3, 10, 11, 1);
+        try check.sameBytes("writeback mode 3: streams", std.mem.sliceAsBytes(try r.back(u16, o3, m * wide)), std.mem.sliceAsBytes(try r.back(u16, o2, m * wide)));
+        try check.sameBytes("writeback mode 3: sums", std.mem.sliceAsBytes(try r.back(f32, p3, m * nc * streams)), std.mem.sliceAsBytes(try r.back(f32, p2, m * nc * streams)));
+        try g.hcWritebackNorm(r.s, dh, o2, p2, 0, dinj, dy2, dw, dscale, n2, eps, m * dims, m, dims, streams, 2, 10, 11, 1);
+        try g.hcWritebackNorm(r.s, dh, o3, p3, dsh, dinj, dy, dw, dscale, n3, eps, m * dims, m, dims, streams, 3, 10, 11, 1);
+        try check.sameBytes("writeback+norm mode 3: streams", std.mem.sliceAsBytes(try r.back(u16, o3, m * wide)), std.mem.sliceAsBytes(try r.back(u16, o2, m * wide)));
+        try check.sameBytes("writeback+norm mode 3: sums", std.mem.sliceAsBytes(try r.back(f32, p3, m * nc * streams)), std.mem.sliceAsBytes(try r.back(f32, p2, m * nc * streams)));
+        try check.sameBytes("writeback+norm mode 3: normed", std.mem.sliceAsBytes(try r.back(u16, n3, m * wide)), std.mem.sliceAsBytes(try r.back(u16, n2, m * wide)));
+        check.pass("hc-fuse: writeback and writeback+norm mode 3 (shared expert in place) = mode 2 over a scattered y, {d} rows", .{m});
+    }
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x4c2);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var g = try flash.Glue.load(gpu.d);
+    defer g.deinit();
+    var lane = try cuda.qmmf.Lane.load(gpu.d, (try gpu.ctx.capability()) / 10);
+    defer lane.unload();
+    var prompt = try cuda.nvfp4.Prompt.load(gpu.d);
+    defer prompt.unload();
+    var t = try tk.TileKernels.load(gpu.d);
+    defer t.unload();
+
+    try sharedDirect(&r, &g);
+    const most = 3072;
+    // bf16 weights in the lane's order, rows padded to 128 with zeros
+    const wd = r.bfs(n_down * wide, 0.04);
+    const wu = r.bfs(wide * low, 0.4);
+    const pd = try r.a.alloc(u16, cuda.nvfp4.padded(n_down) * wide);
+    cuda.qmmf.packBf16(pd, wd, n_down, wide);
+    const pu = try r.a.alloc(u16, cuda.nvfp4.padded(wide) * low);
+    cuda.qmmf.packBf16(pu, wu, wide, low);
+    const h = r.bfs(most * wide, 3);
+    const scale = r.f32s(wide, 0.5, 1.5);
+    const dh = try r.dev(std.mem.sliceAsBytes(h));
+    const dpss = try r.out(most * nc * streams * 4);
+    var c: Chain = .{
+        .r = &r,
+        .g = &g,
+        .lane = &lane,
+        .prompt = &prompt,
+        .t = &t,
+        .wdown = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pd)), n_down, wide),
+        .wup = cuda.modelopt.bf16Weight(try r.dev(std.mem.sliceAsBytes(pu)), wide, low),
+        .h = dh,
+        .pss = dpss,
+        .scale = try r.dev(std.mem.sliceAsBytes(scale)),
+        .norm = try r.out(most * wide * 2),
+        .part = try r.out(most * n_down * 4),
+        .act = try r.out(most * low * 2),
+        .xs = try r.out(most * (low / 32) * 4),
+        .inj = try r.out(most * streams * 2),
+        .up = try r.out(most * wide * 2),
+        .mixed = try r.out(most * dims * 2),
+        .xsm = try r.out(most * (dims / 32) * 4),
+        .spart = try r.out(8 * most * n_down * 4),
+        .rows = most,
+    };
+    try g.hcWriteback(r.s, dh, 0, dpss, 0, 0, 0, 0, most * dims, most, dims, streams, 0, 1, 1, 1);
+
+    for ([_]usize{ 64, 65, 193, 255, 256, 1000, 1023, 1024, 1536, 2053, 3072 }) |m| {
+        c.rows = m;
+        try c.base();
+        const part0 = try r.back(f32, c.part, m * n_down);
+        const act0 = try r.back(u16, c.act, m * low);
+        const xs0 = try r.back(f32, c.xs, m * (low / 32));
+        const inj0 = try r.back(u16, c.inj, m * streams);
+        const mixed0 = try r.back(u16, c.mixed, m * dims);
+        const xsm0 = try r.back(f32, c.xsm, m * (dims / 32));
+        for (0..tk.hcn_down_mt.len) |di| {
+            try c.poison();
+            try c.newDown(di);
+            try check.sameBytes("down", std.mem.sliceAsBytes(try r.back(f32, c.part, m * n_down)), std.mem.sliceAsBytes(part0));
+            try c.reduce();
+            try c.newUp();
+            try check.sameBytes("act", std.mem.sliceAsBytes(try r.back(u16, c.act, m * low)), std.mem.sliceAsBytes(act0));
+            try check.sameBytes("act sums", std.mem.sliceAsBytes(try r.back(f32, c.xs, m * (low / 32))), std.mem.sliceAsBytes(xs0));
+            try check.sameBytes("inject", std.mem.sliceAsBytes(try r.back(u16, c.inj, m * streams)), std.mem.sliceAsBytes(inj0));
+            try check.sameBytes("mixed", std.mem.sliceAsBytes(try r.back(u16, c.mixed, m * dims)), std.mem.sliceAsBytes(mixed0));
+            try check.sameBytes("mixed sums", std.mem.sliceAsBytes(try r.back(f32, c.xsm, m * (dims / 32))), std.mem.sliceAsBytes(xsm0));
+        }
+        check.pass("hc-fuse: {d} rows, down tiles {d}: every output byte equals the normalize/down/reduce/up/mix chain's", .{ m, tk.hcn_down_mt.len });
+    }
+
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    for ([_]usize{ 3072, 2048, 1536, 1024, 768, 512 }) |m| {
+        c.rows = m;
+        const chain = try timeOf(&c, start, end, Chain.base, .{});
+        var best: f64 = 1e18;
+        for (0..tk.hcn_down_mt.len) |di| best = @min(best, try timeOf(&c, start, end, Chain.fused, .{di}));
+        std.debug.print("RESULT hc-fuse rows {d}: chain {d:.1} us, fused best {d:.1} us (the writeback's normalize not counted)\n", .{ m, chain, best });
+    }
+    r.report("hc-fuse");
+}
