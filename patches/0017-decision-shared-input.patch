+        error.Refused => return cx.refuse(d.problem),
+        error.Failed => return cx.fail(.server, "decision scoring failed", .{}),
+    };
+    var at: usize = 0;
+    for (scored, counts, lse) |*row, n, s| {
+        row.* = .{ .logits = logits[at..][0..n], .logsumexp = s };
+        at += n;
+    }
+    return true;
+}
