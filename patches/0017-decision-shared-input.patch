+/// Every question in one packed decision when the engine takes them (Engine.decide): the prompts' shared start (the chat
+/// template's opening and the input) is read once and each question's own tokens after it; false: score one by one.
+fn asOne(srv: *Server, cx: *Cx, prepared: []const Prepared, identity: u8, scored: []Scored) errors.Refused!bool {
+    if (srv.engine.vtable.decide == null or prepared.len == 0) return false;
+    const first = prepared[0].prompt_ids;
+    var trunk = first.len;
+    for (prepared) |p| {
+        trunk = @min(trunk, std.mem.indexOfDiff(u32, first, p.prompt_ids) orelse first.len);
+        trunk = @min(trunk, p.prompt_ids.len - 1); // each question keeps a token of its own
+    }
+    if (trunk == 0) return false;
