-        if (bytes <= s.budget) try out.append(a, at) else {
+        if (bytes <= s.budget) {
+            try out.append(a, at);
+            kept = @max(kept, at);
+            beside += bytes;
+        } else {
             s.counts.refused += 1;
+            refused = @min(refused orelse at, at);
             pc.note("kept nothing at {d} tokens: {d} MiB passes the {d} MiB budget{s}", .{ at, bytes >> 20, s.budget >> 20, s.over });
         }
     }
+    // states grow with their row, so every mark from `refused` on passes the budget and every kept one lies before it
+    if (s.partial and !s.rules.planned) if (refused) |at| if (furthest(s, kept, at, s.budget -| beside)) |near| {
+        try out.append(a, near);
+        pc.note("kept {d} of {d} tokens instead: the furthest state past {d} the budget holds", .{ near, at, kept });
+    };
     return out.toOwnedSlice(a);
 }
 
+/// The mark a guarded reservation makes room for: `endpoint`, or with `s.partial` and an endpoint past the whole
+/// budget, the furthest mark `fitting` kept in its place (none past `from`: the endpoint, which keeps nothing).
+pub fn primary(s: *const pc.Store, marks_: []const u32, endpoint: u32, from: u32) u32 {
+    if (!s.partial or marks_.len == 0 or s.family.vtable.bytes(s.family.ptr, endpoint) <= s.budget) return endpoint;
+    const last = std.mem.max(u32, marks_);
+    return if (last > from and last < endpoint) last else endpoint;
+}
+
+/// The furthest row past `from` and before `at` whose state `room` bytes hold, on a disk block's edge when one is
+/// past `from` (consecutive turns then share whole blocks); null when even `from + 1` passes `room`.
+fn furthest(s: *const pc.Store, from: u32, at: u32, room: u64) ?u32 {
+    const fits = struct {
+        fn f(st: *const pc.Store, n: u32, bytes: u64) bool {
+            return st.family.vtable.bytes(st.family.ptr, n) <= bytes;
+        }
+    }.f;
+    if (at <= from + 1 or !fits(s, from + 1, room)) return null;
+    var lo = from + 1; // fits
+    var hi = at; // passes
+    while (hi - lo > 1) {
+        const mid = lo + (hi - lo) / 2;
+        if (fits(s, mid, room)) lo = mid else hi = mid;
+    }
+    const edge = lo - lo % @import("rows_store.zig").block_tokens;
+    return if (edge > from) edge else lo;
+}
+
