+/// The marks the budget can hold (a new slice in `a`) for a pass from `from`. Refuse the rest before any pass or peer
+/// copies them; when every mark is refused and `s.partial` is on, an unplanned family keeps the furthest state past
+/// `from` the budget holds (it may evict every other state to make that room).
+pub fn fitting(s: *pc.Store, a: Allocator, marks_: []const u32, from: u32) ![]const u32 {
     defer a.free(marks_);
