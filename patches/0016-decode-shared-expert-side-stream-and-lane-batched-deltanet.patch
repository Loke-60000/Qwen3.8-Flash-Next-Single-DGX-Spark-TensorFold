diff --git a/zig/tests/cuda/flashnext_gdn_lanes_tests.zig b/zig/tests/cuda/flashnext_gdn_lanes_tests.zig
new file mode 100644
index 000000000..7c7c6d847
--- /dev/null
+++ b/zig/tests/cuda/flashnext_gdn_lanes_tests.zig
@@ -0,0 +1,150 @@
+//! TF_FLASHNEXT_GDN_LANES: a shared round's lanes in three launches (fn_gdn_front_lanes, fn_gdn_rows_late_lanes,
+//! fn_shift_window_lanes) against the per-lane loop they replace (copy proj, copy history, fn_gdn_front_log,
+//! fn_gdn_rows_late, fn_shift_window a lane): every byte each writes, over lanes of different rows and pending counts.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const Rig = rig.Rig;
+const parts = flash.batch_state;
+const late = flash.batch_late;
+
+const nk = 16;
+const nv = 48;
+const dk = 128;
+const dv = 128;
+const taps = 4;
+const conv_c = 2 * nk * dk + nv * dv;
+const proj_w = conv_c + nv * dv + 2 * nv;
+const lr = parts.late_rows;
+const log_len = lr * (nk * dk + nv * dv + nv * 2) * 4;
+const state_len = nv * dv * dk * 4;
+
+/// One lane's buffers: what it reads and every byte the two forms write.
+const Bufs = struct { conv: u64, proj_save: u64, hist_save: u64, log: u64, state: u64, state_out: u64 };
+
+const Fns = struct { front_log: cuda.Function, rows_late: cuda.Function, shift: cuda.Function, front_lanes: cuda.Function, rows_lanes: cuda.Function, shift_lanes: cuda.Function };
+
+fn copy(r: *Rig, dst: u64, src: u64, len: usize) !void {
+    try (cuda.DeviceBuffer{ .d = r.gpu.d, .ptr = dst, .len = len }).copyFrom(0, src, len, r.s.handle);
+}
+
+fn dup(r: *Rig, src: u64, len: usize) !u64 {
+    const p = try r.out(len);
+    try copy(r, p, src, len);
+    return p;
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x6d1);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.flashnext_batch);
+    defer mod.unload();
+    const f: Fns = .{
+        .front_log = try mod.function("fn_gdn_front_log"),
+        .rows_late = try mod.function("fn_gdn_rows_late"),
+        .shift = try mod.function("fn_shift_window"),
+        .front_lanes = try mod.function("fn_gdn_front_lanes"),
+        .rows_lanes = try mod.function("fn_gdn_rows_late_lanes"),
+        .shift_lanes = try mod.function("fn_shift_window_lanes"),
+    };
+    const rows = [_]usize{ 1, 7, 16, 3, 9 };
+    // pending rows: none, at the store threshold, past it; the window may wrap the log
+    const pending = [_]usize{ 0, parts.late_store, parts.late_store + 5, 4, 30 };
+    const first = [_]usize{ 0, lr - 3, 11, lr - 1, 20 };
+    var total: usize = 0;
+    for (rows) |m| total += m;
+    const proj = try r.dev(std.mem.sliceAsBytes(r.bfs(total * proj_w, 1)));
+    const cw = try r.dev(std.mem.sliceAsBytes(r.bfs(conv_c * taps, 0.5)));
+    const a_log = try r.dev(std.mem.sliceAsBytes(r.f32s(nv, -1, 1)));
+    const dt = try r.dev(std.mem.sliceAsBytes(r.f32s(nv, -1, 1)));
+    var ctls: [rows.len]u64 = undefined;
+    var base: [rows.len]Bufs = undefined;
+    var forms: [2][rows.len]Bufs = undefined;
+    for (0..rows.len) |i| {
+        const ctl = [4]u32{ @intCast(first[i] | pending[i] << 16), 0, 0, 0 };
+        ctls[i] = try r.dev(std.mem.sliceAsBytes(&ctl));
+        const gs = r.f32s(lr * nv * 2, 0.5, 1);
+        const log = try std.mem.concat(r.a, u8, &.{ std.mem.sliceAsBytes(r.f32s(lr * nk * dk, -0.1, 0.1)), std.mem.sliceAsBytes(r.f32s(lr * nv * dv, -1, 1)), std.mem.sliceAsBytes(gs) });
+        base[i] = .{
+            .conv = try r.dev(std.mem.sliceAsBytes(r.bfs((taps - 1) * conv_c, 1))),
+            .proj_save = 0,
+            .hist_save = 0,
+            .log = try r.dev(log),
+            .state = try r.dev(std.mem.sliceAsBytes(r.f32s(nv * dv * dk, -0.5, 0.5))),
+            .state_out = 0,
+        };
+        for (&forms) |*fm| fm[i] = .{
+            .conv = try dup(&r, base[i].conv, (taps - 1) * conv_c * 2),
+            .proj_save = try r.out(rows[i] * proj_w * 2),
+            .hist_save = try r.out((taps - 1) * conv_c * 2),
+            .log = try dup(&r, base[i].log, log_len),
+            .state = try dup(&r, base[i].state, state_len),
+            .state_out = try r.out(state_len),
+        };
+    }
+    var qs: [2]u64 = undefined;
+    var ys: [2]u64 = undefined;
+    for (&qs, &ys) |*q, *y| {
+        q.* = try r.out(total * nk * dk * 4);
+        y.* = try r.out(total * nv * dv * 4);
+    }
+
+    // the per-lane loop, as cuda_batch.zig's gdnBlock runs it
+    var row0: usize = 0;
+    for (rows, 0..) |m, i| {
+        const b = forms[0][i];
+        const p = proj + row0 * proj_w * 2;
+        try copy(&r, b.proj_save, p, m * proj_w * 2);
+        try copy(&r, b.hist_save, b.conv, (taps - 1) * conv_c * 2);
+        var a: cuda.Args = .{};
+        for ([_]u64{ p, b.conv, cw, a_log, dt, qs[0] + row0 * nk * dk * 4, b.log, ctls[i] }) |v| a.add(v);
+        a.add(@as(c_int, lr));
+        try cuda.launch.launch(f.front_log, .{ .grid = .{ .x = @intCast(m), .y = nk + nv }, .block = .{ .x = 256 } }, r.s, &a);
+        var c: cuda.Args = .{};
+        for ([_]u64{ qs[0] + row0 * nk * dk * 4, b.log, ctls[i] }) |v| c.add(v);
+        c.add(@as(c_int, lr));
+        c.add(@as(c_int, parts.late_store));
+        c.add(b.state);
+        c.add(b.state_out);
+        c.add(@as(c_int, @intCast(m)));
+        c.add(ys[0] + row0 * nv * dv * 4);
+        try cuda.launch.launch(f.rows_late, .{ .grid = .{ .x = nv, .y = dv / 16 }, .block = .{ .x = 128 } }, r.s, &c);
+        var s: cuda.Args = .{};
+        s.add(b.conv);
+        s.add(p);
+        s.add(@as(i64, proj_w));
+        for ([_]c_int{ @intCast(m), taps - 1, conv_c }) |v| s.add(v);
+        try cuda.launch.launch(f.shift, .{ .grid = .{ .x = (conv_c + 255) / 256 }, .block = .{ .x = 256 } }, r.s, &s);
+        row0 += m;
+    }
+
+    // the three launches
+    var tab = std.mem.zeroes(late.Lanes);
+    row0 = 0;
+    for (rows, 0..) |m, i| {
+        const b = forms[1][i];
+        tab.lane[i] = .{ .proj = proj + row0 * proj_w * 2, .conv = b.conv, .proj_save = b.proj_save, .hist_save = b.hist_save, .qn = qs[1] + row0 * nk * dk * 4, .log = b.log, .ctl = ctls[i], .state_in = b.state, .state_out = b.state_out, .ys = ys[1] + row0 * nv * dv * 4, .rows = @intCast(m) };
+        row0 += m;
+    }
+    try late.launchLanes(&.{ .front_lanes = f.front_lanes, .chain_lanes = f.rows_lanes, .shift_lanes = f.shift_lanes }, r.s, tab, rows.len, 16, cw, a_log, dt);
+
+    try check.sameBytes("q rows", std.mem.sliceAsBytes(try r.back(u8, qs[1], total * nk * dk * 4)), std.mem.sliceAsBytes(try r.back(u8, qs[0], total * nk * dk * 4)));
+    try check.sameBytes("readouts", std.mem.sliceAsBytes(try r.back(u8, ys[1], total * nv * dv * 4)), std.mem.sliceAsBytes(try r.back(u8, ys[0], total * nv * dv * 4)));
+    for (rows, 0..) |m, i| {
+        const want = forms[0][i];
+        const got = forms[1][i];
+        const lens = [_]usize{ (taps - 1) * conv_c * 2, m * proj_w * 2, (taps - 1) * conv_c * 2, log_len, state_len, state_len };
+        const names = [_][]const u8{ "conv window", "projection copy", "history copy", "log", "state in place", "state after" };
+        inline for (.{ "conv", "proj_save", "hist_save", "log", "state", "state_out" }, 0..) |field, j| {
+            try check.sameBytes(names[j], try r.back(u8, @field(got, field), lens[j]), try r.back(u8, @field(want, field), lens[j]));
+        }
+    }
+    check.pass("flashnext-gdn-lanes: {d} lanes (rows 1..16, pending 0..30, wrapping logs): every byte equals the per-lane loop's", .{rows.len});
+    r.report("flashnext-gdn-lanes");
+}
