+/// One lane of a shared round's DeltaNet layer for the lane-batched kernels (flashnext_batch.cu fn_lanes::Lane).
+pub const Lane = extern struct { proj: u64, conv: u64, proj_save: u64, hist_save: u64, qn: u64, log: u64, ctl: u64, state_in: u64, state_out: u64, ys: u64, rows: c_int };
+pub const lanes_max = 16;
+/// The lanes passed by value (fn_lanes::Lanes).
+pub const Lanes = extern struct { lane: [lanes_max]Lane };
+
+/// TF_FLASHNEXT_GDN_LANES=1: a shared round whose lanes all log their rows takes a DeltaNet layer in three launches.
+pub fn lanesOn() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_GDN_LANES") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// A shared round's layer for every lane at once (TF_FLASHNEXT_GDN_LANES); false, nothing queued, unless all log.
+pub fn lanes(pass: anytype, lw: *const Layer, layer: usize, li: usize) !bool {
+    if (!lanesOn() or pass.lanes.len > lanes_max) return false;
+    for (pass.lanes) |l| {
+        const kp = l.keep orelse return false;
+        const lk = kp.layers[layer];
+        if (lk.log == 0 or lk.state_out == 0 or lk.proj % 4 != 0) return false;
+    }
+    const s = pass.s;
+    var tab = std.mem.zeroes(Lanes);
+    var row0: usize = 0;
+    var most: usize = 0;
+    for (pass.lanes, 0..) |l, i| {
+        const lk = l.keep.?.layers[layer];
+        tab.lane[i] = .{ .proj = s.proj + row0 * gdn.proj_width * 2, .conv = l.seq.conv[li].ptr, .proj_save = lk.proj, .hist_save = lk.hist, .qn = s.gq + row0 * gdn.nk * gdn.dk * 4, .log = lk.log, .ctl = lk.log_ctl, .state_in = l.seq.state[li].ptr, .state_out = lk.state_out, .ys = s.ys + row0 * gdn.value_dim * 4, .rows = cint(l.rows) };
+        most = @max(most, l.rows);
+        row0 += l.rows;
+    }
+    try launchLanes(pass.k, pass.stream, tab, pass.lanes.len, most, lw.cw.ptr, lw.a_log.ptr, lw.dt.ptr);
+    return true;
+}
+
+/// The three launches over `n` lanes of `tab` (`most` rows at most): front and copy, chain, history and shift.
+pub fn launchLanes(k: anytype, stream: cuda.Stream, tab: Lanes, n: usize, most: usize, cw: u64, a_log: u64, dt: u64) !void {
+    const z: u32 = @intCast(n);
+    var f: cuda.Args = .{};
+    f.add(tab);
+    for ([_]u64{ cw, a_log, dt }) |v| f.add(v);
+    f.add(cint(parts.late_rows));
+    try cuda.launch.launch(k.front_lanes, .{ .grid = .{ .x = @intCast(most), .y = gdn.nk + gdn.nv, .z = z }, .block = .{ .x = 256 } }, stream, &f);
+    var a: cuda.Args = .{};
+    a.add(tab);
+    a.add(cint(parts.late_rows));
+    a.add(cint(parts.late_store));
+    try cuda.launch.launch(k.chain_lanes, .{ .grid = .{ .x = gdn.nv, .y = gdn.dv / 16, .z = z }, .block = .{ .x = 128 } }, stream, &a);
+    var h: cuda.Args = .{};
+    h.add(tab);
+    h.add(cint(gdn.taps - 1));
+    h.add(cint(gdn.conv_dim));
+    try cuda.launch.launch(k.shift_lanes, .{ .grid = .{ .x = @intCast((gdn.conv_dim + 255) / 256), .y = z }, .block = .{ .x = 256 } }, stream, &h);
+}
+
+test "the lane table is flashnext_batch.cu's fn_lanes::Lanes" {
+    try std.testing.expectEqual(@as(usize, 88), @sizeOf(Lane));
+    try std.testing.expectEqual(@as(usize, 80), @offsetOf(Lane, "rows"));
+    try std.testing.expectEqual(@as(usize, 16 * 88), @sizeOf(Lanes));
+}
