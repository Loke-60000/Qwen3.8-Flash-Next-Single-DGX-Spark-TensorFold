+// TF_FLASHNEXT_GDN_LANES: a shared round's logged lanes in three launches, each lane the per-lane kernels' program.
+namespace fn_lanes {
+struct Lane {  // proj [rows, PW], conv window, their copies (or null), q rows, log and ctl, states, readouts
+    const __nv_bfloat16* proj;
+    __nv_bfloat16 *conv, *proj_save, *hist_save;
+    float *qn, *log;
+    const unsigned* ctl;
+    float *state_in, *state_out, *ys;
+    int rows;
+};
+struct Lanes {
+    Lane lane[16];
+};
+}  // namespace fn_lanes
+
+// Program (row, unit, lane): the lane's fn_gdn_front_log of row r, and a slice of the copy of its projection rows.
+extern "C" __global__ void __launch_bounds__(256) fn_gdn_front_lanes(const __grid_constant__ fn_lanes::Lanes L, const __nv_bfloat16* __restrict__ cw,
+                                                                     const float* __restrict__ a_log, const float* __restrict__ dt_bias, int log_rows) {
+    using namespace fn_gdn;
+    const fn_lanes::Lane& l = L.lane[blockIdx.z];
+    if ((int)blockIdx.x >= l.rows) return;
+    if (l.proj_save != nullptr) {
+        const unsigned total = (unsigned)l.rows * (PW / 2), blocks = (unsigned)l.rows * gridDim.y;
+        const unsigned per = (total + blocks - 1) / blocks, lo = (blockIdx.x * gridDim.y + blockIdx.y) * per;
+        const unsigned hi = lo + per < total ? lo + per : total;
+        for (unsigned i = lo + threadIdx.x; i < hi; i += blockDim.x) reinterpret_cast<unsigned*>(l.proj_save)[i] = reinterpret_cast<const unsigned*>(l.proj)[i];
+    }
+    float* vl = l.log + (size_t)log_rows * NK * DK;
+    gdn_front<true>(l.proj, l.conv, cw, a_log, dt_bias, l.qn, l.log, vl, vl + (size_t)log_rows * NV * DV, l.ctl, log_rows);
+}
+
+// Program (value head, 16 state rows, lane): fn_gdn_rows_late on the lane's pointers.
+extern "C" __global__ void __launch_bounds__(128) fn_gdn_rows_late_lanes(const __grid_constant__ fn_lanes::Lanes L, int log_rows, int store_above) {
+    const fn_lanes::Lane& l = L.lane[blockIdx.z];
+    gdn_rows_late(l.qn, l.log, l.ctl, log_rows, store_above, l.state_in, l.state_out, l.rows, l.ys);
+}
+
+// Program (256 channels, lane): the lane's history copy, then fn_shift_window over its rows (PW apart).
+extern "C" __global__ void __launch_bounds__(256) fn_shift_window_lanes(const __grid_constant__ fn_lanes::Lanes L, int taps, int c) {
+    const fn_lanes::Lane& l = L.lane[blockIdx.y];
+    const int ch = blockIdx.x * blockDim.x + threadIdx.x;
+    if (ch >= c) return;
+    if (l.hist_save != nullptr)
+        for (int j = 0; j < taps; ++j) l.hist_save[(long long)j * c + ch] = l.conv[(long long)j * c + ch];
+    shift_window(l.conv, l.proj, fn_gdn::PW, l.rows, taps, c);
+}
