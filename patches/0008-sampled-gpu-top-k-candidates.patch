diff --git a/zig/src/families/flashnext/cuda_mtp_cand.zig b/zig/src/families/flashnext/cuda_mtp_cand.zig
new file mode 100644
index 000000000..a8defa1af
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_mtp_cand.zig
@@ -0,0 +1,300 @@
+//! A sampled draw's candidates from the GPU (fn_row_cand): the row's top_k best scores, not the whole row.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const mtp = @import("cuda_mtp.zig");
+
+const Sampling = mtp.Sampling;
+const Pick = mtp.Pick;
+const Head = mtp.Head;
+const Draft = mtp.Draft;
+const promote = mtp.promote;
+
+/// Candidates a row's draw reads at most (a request's top_k; a larger one takes the whole row).
+pub const cand_max: usize = 64;
+/// Rows one launch of fn_row_cand serves at most (a window's rows, or the lanes of a batched head step).
+pub const cand_slots: usize = 16;
+/// Device scratch: vals [cand_slots, cand_max] f32, cols [cand_slots, cand_max] i32, flags [cand_slots] i32.
+pub const cand_bytes: usize = 2 * cand_slots * cand_max * 4 + cand_slots * 4;
+
+/// TF_FLASHNEXT_SAMPLE_CAND=1: a sampled draw reads its row's top_k from the device (same bits), else the whole row.
+pub fn candidatesOn() bool {
+    const v = std.c.getenv("TF_FLASHNEXT_SAMPLE_CAND") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "1");
+}
+
+/// Candidates a draw of `sm` over `n` scores needs; null reads the row whole (greedy, top_k 0, >= n or > cand_max).
+pub fn candidateCount(sm: ?Sampling, n: usize) ?usize {
+    const s = sm orelse return null;
+    if (s.temperature <= 0 or s.top_k == 0 or s.top_k >= n or s.top_k > cand_max) return null;
+    return s.top_k;
+}
+
+/// The scratch on the host: slot s holds vals / cols [s * cand_max ..] and flags[s] (non-zero: read that row whole).
+pub const Cands = struct {
+    vals: [cand_slots * cand_max]f32 = undefined,
+    cols: [cand_slots * cand_max]i32 = undefined,
+    flags: [cand_slots]i32 = undefined,
+
+    /// Slots [0, n) of the head's scratch, once the stream is done.
+    pub fn read(c: *Cands, h: *const Head, stream: cuda.Stream, n: usize) !void {
+        const base = (h.cand_buf orelse return error.NoCandidates).ptr;
+        try download(stream, std.mem.sliceAsBytes(c.vals[0 .. n * cand_max]), base);
+        try download(stream, std.mem.sliceAsBytes(c.cols[0 .. n * cand_max]), base + cand_slots * cand_max * 4);
+        try download(stream, std.mem.sliceAsBytes(c.flags[0..n]), base + 2 * cand_slots * cand_max * 4);
+    }
+};
+
+fn download(stream: cuda.Stream, dst: []u8, src: u64) !void {
+    const d = stream.d;
+    try stream.synchronize();
+    try d.check(d.api.cuMemcpyDtoH_v2(dst.ptr, src, dst.len), "cuMemcpyDtoH");
+}
+
+/// fn_row_cand over `rows` rows of `v` scores `ld` apart: each row's first `count` into slots [slot, slot + rows).
+pub fn launch(h: *const Head, stream: cuda.Stream, scores: u64, v: usize, ld: usize, rows: usize, count: usize, slot: usize) !void {
+    const f = h.cand_fn orelse return error.NoCandidates;
+    const buf = h.cand_buf orelse return error.NoCandidates;
+    if (rows == 0 or slot + rows > cand_slots or count == 0 or count > cand_max) return error.BadCandidates;
+    var a: cuda.Args = .{};
+    a.add(scores);
+    a.add(@as(c_int, @intCast(v)));
+    a.add(@as(c_longlong, @intCast(ld)));
+    a.add(@as(c_int, @intCast(count)));
+    a.add(@as(c_int, @intCast(cand_max)));
+    a.add(buf.ptr + slot * cand_max * 4);
+    a.add(buf.ptr + (cand_slots + slot) * cand_max * 4);
+    a.add(buf.ptr + 2 * cand_slots * cand_max * 4 + slot * 4);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 1024 } }, stream, &a);
+}
+
+/// Ops.pick's sampled draw over the head's `n` scores: from the device's candidates, else the whole row (a NaN row).
+pub fn pickRow(h: *const Head, stream: cuda.Stream, gpa: std.mem.Allocator, d: *Draft, n: usize, lse: f32, position: u64, sm: ?Sampling) !Pick {
+    if (candidatesOn()) if (candidateCount(sm, n)) |count| {
+        var c: Cands = undefined;
+        try launch(h, stream, d.dlogits.ptr, n, n, 1, count, 0);
+        try c.read(h, stream, 1);
+        if (c.flags[0] == 0) return drawPickCandidates(gpa, c.vals[0..count], c.cols[0..count], h.ids, lse, position, sm);
+    };
+    const row = d.host[0..n];
+    try download(stream, std.mem.sliceAsBytes(row), d.dlogits.ptr);
+    return mtp.drawPick(gpa, row, h.ids, lse, position, sm);
+}
+
+/// A batched head step's sampled lanes: their candidates selected beside the bests and read back together.
+pub const Step = struct {
+    k: [cand_slots]usize = @splat(0),
+    c: Cands = .{},
+
+    /// fn_row_cand for each active lane (draft act[r]) whose rule takes candidates, then the read-back.
+    pub fn run(h: *const Head, stream: cuda.Stream, ds: []const *Draft, act: []const usize, sms: []const ?Sampling) !Step {
+        var s: Step = .{};
+        if (!candidatesOn()) return s;
+        var any = false;
+        for (act, 0..) |i, r| if (candidateCount(sms[i], h.ids.len)) |count| {
+            s.k[r] = count;
+            any = true;
+            try launch(h, stream, ds[i].dlogits.ptr, h.ids.len, h.ids.len, 1, count, r);
+        };
+        if (any) try s.c.read(h, stream, act.len);
+        return s;
+    }
+
+    /// Lane r's draw (draft `d`) as its lone pick makes it: from its candidates, else its whole row.
+    pub fn draw(s: *const Step, h: *const Head, stream: cuda.Stream, gpa: std.mem.Allocator, r: usize, d: *Draft, lse: f32, position: u64, sm: ?Sampling) !Pick {
+        const k = s.k[r];
+        if (k > 0 and s.c.flags[r] == 0) {
+            const at = r * cand_max;
+            return drawPickCandidates(gpa, s.c.vals[at..][0..k], s.c.cols[at..][0..k], h.ids, lse, position, sm);
+        }
+        const row = d.host[0..h.ids.len];
+        try download(stream, std.mem.sliceAsBytes(row), d.dlogits.ptr);
+        return mtp.drawPick(gpa, row, h.ids, lse, position, sm);
+    }
+};
+
+/// Ops.draws' sampled rows (no masks) at positions first + r from their candidates; false: read the window whole.
+pub fn window(h: *const Head, stream: cuda.Stream, gpa: std.mem.Allocator, scores: u64, v: usize, n: usize, first: u64, sm: ?Sampling, out: []u32) !bool {
+    if (!candidatesOn() or n > cand_slots) return false;
+    const count = candidateCount(sm, v) orelse return false;
+    var c: Cands = undefined;
+    try launch(h, stream, scores, v, v, n, count, 0);
+    try c.read(h, stream, n);
+    if (!std.mem.allEqual(i32, c.flags[0..n], 0)) return false;
+    for (out[0..n], 0..) |*t, r| {
+        const at = r * cand_max;
+        t.* = try drawCandidates(gpa, c.vals[at..][0..count], c.cols[at..][0..count], null, first + r, sm);
+    }
+    return true;
+}
+
+/// A bf16 score's 16-bit sort key (fn_row_cand's): larger scores larger keys, +0 and -0 one key (NaN has none).
+pub fn candidateKey(bits: u16) u16 {
+    const u: u32 = if (bits & 0x7fff == 0) 0 else bits;
+    return @intCast(if (u & 0x8000 != 0) ~u & 0xffff else u | 0x8000);
+}
+
+/// Whether a bf16 score is a NaN (a row with one has no total order: the host reads it whole).
+pub fn candidateNan(bits: u16) bool {
+    return bits & 0x7fff > 0x7f80;
+}
+
+/// The row's first `count` scores and columns in the draw's order, as fn_row_cand selects them; false for a NaN row.
+pub fn topCandidates(row: []const u16, count: usize, vals: []f32, cols: []i32) bool {
+    // the draw's order: the larger score first, of equal scores the lower column; +0 and -0 equal; output in any order
+    const k = @min(count, row.len);
+    var hist: [256]u32 = @splat(0);
+    for (row) |b| {
+        if (candidateNan(b)) return false;
+        hist[candidateKey(b) >> 8] += 1;
+    }
+    // the count-th largest key by two 8-bit histogram passes, then the keys above it and the lowest columns equal to it
+    var left: u32 = @intCast(k);
+    var hi: usize = 255;
+    var above: u32 = 0;
+    while (hi > 0 and above + hist[hi] < left) : (hi -= 1) above += hist[hi];
+    left -= above;
+    hist = @splat(0);
+    for (row) |b| if (candidateKey(b) >> 8 == hi) {
+        hist[candidateKey(b) & 255] += 1;
+    };
+    var lo: usize = 255;
+    above = 0;
+    while (lo > 0 and above + hist[lo] < left) : (lo -= 1) above += hist[lo];
+    left -= above; // the keys equal to the cut that are taken: the lowest columns
+    const cut: u16 = @intCast(hi << 8 | lo);
+    const taken_above = k - left;
+    var n_above: usize = 0;
+    var n_tie: usize = 0;
+    for (row, 0..) |b, col| {
+        const key = candidateKey(b);
+        if (key > cut) {
+            vals[n_above] = promote(b);
+            cols[n_above] = @intCast(col);
+            n_above += 1;
+        } else if (key == cut and n_tie < left) {
+            vals[taken_above + n_tie] = promote(b);
+            cols[taken_above + n_tie] = @intCast(col);
+            n_tie += 1;
+        }
+    }
+    return true;
+}
+
+/// drawRow over a row's top_k candidates (any order): choose orders them by score and id, so it is drawRow's draw.
+pub fn drawCandidates(gpa: std.mem.Allocator, vals: []const f32, cols: []const i32, ids: ?[]const u32, position: u64, sm: ?Sampling) !u32 {
+    const s = sm orelse return error.NotSampled;
+    if (vals.len != cols.len or vals.len == 0 or vals.len > cand_max) return error.BadCandidates;
+    var v: [cand_max]f64 = undefined;
+    var key: [cand_max]u64 = undefined;
+    for (vals, cols, 0..) |x, c, i| {
+        v[i] = x;
+        key[i] = if (ids) |m| m[@intCast(c)] else @intCast(c);
+    }
+    return @intCast(try lanes.sampling.choose(gpa, v[0..vals.len], key[0..vals.len], position, s));
+}
+
+/// drawPick over a row's candidates: the drawn token's probability from its own candidate score.
+pub fn drawPickCandidates(gpa: std.mem.Allocator, vals: []const f32, cols: []const i32, ids: []const u32, lse: f32, position: u64, sm: ?Sampling) !Pick {
+    const tok = try drawCandidates(gpa, vals, cols, ids, position, sm);
+    for (vals, cols) |x, c| if (ids[@intCast(c)] == tok) return .{ .token = tok, .prob = @exp(@as(f64, x) - @as(f64, lse)) };
+    return .{ .token = tok, .prob = 0 };
+}
+
+/// A bf16 row of `n` scores drawn from a few values so that ties at any cut are common, with both zeros and infinities.
+fn tiedRow(prng: *std.Random.DefaultPrng, row: []u16, levels: u8) void {
+    const specials = [_]u16{ 0x0000, 0x8000, 0x7f80, 0xff80, 0x3f80, 0xbf80 };
+    for (row) |*v| {
+        const r = prng.random().int(u16);
+        v.* = if (r % 17 == 0) specials[r / 17 % specials.len] else @as(u16, 0x3f00) + prng.random().uintLessThan(u8, levels);
+    }
+}
+
+test "a row's candidates are its top_k best columns, ties to the lower column, whatever the order they come in" {
+    var prng = std.Random.DefaultPrng.init(21);
+    var row: [1500]u16 = undefined;
+    var vals: [cand_max]f32 = undefined;
+    var cols: [cand_max]i32 = undefined;
+    for ([_]u8{ 1, 2, 5, 40, 200 }) |levels| for ([_]usize{ 1, 2, 3, 20, 31, 64 }) |count| {
+        for ([_]usize{ 70, 300, 1500 }) |n| {
+            tiedRow(&prng, row[0..n], levels);
+            try std.testing.expect(topCandidates(row[0..n], count, &vals, &cols));
+            // the brute force: every column ranked by score (equal scores by column), the first `count`
+            var rank: [1500]u16 = undefined;
+            for (rank[0..n], 0..) |*r, i| r.* = @intCast(i);
+            std.mem.sort(u16, rank[0..n], row[0..n], struct {
+                fn before(r: []const u16, a: u16, b: u16) bool {
+                    const x = promote(r[a]);
+                    const y = promote(r[b]);
+                    return x > y or (x == y and a < b);
+                }
+            }.before);
+            const k = @min(count, n);
+            var want: [cand_max]i32 = undefined;
+            for (want[0..k], rank[0..k]) |*w, r| w.* = r;
+            std.mem.sort(i32, want[0..k], {}, std.sort.asc(i32));
+            std.mem.sort(i32, cols[0..k], {}, std.sort.asc(i32));
