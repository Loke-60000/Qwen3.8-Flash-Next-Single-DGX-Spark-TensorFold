--- /dev/null
+++ b/zig/src/families/flashnext/cuda_kv4.zig
@@ -0,0 +1,257 @@
+//! NVFP4 attention-cache rows (--kv-cache fp8 with TF_FLASHNEXT_KV4, cuda_kv.zig Kv.fp8_nvfp4 and Kv.nvfp4).
+//!
+//! A (position, KV head) row of head_dim values is NVFP4's two-level scaling with a power-of-two outer scale:
+//!   row [144] bytes: 128 bytes of E2M1 codes, value 2i in the low nibble of byte i and 2i + 1 in the high one, then
+//!   16 E4M3 block scales, one for each 16 values; the row scale R (fp32) sits in the key row's trailer (s_k or s_v).
+//! A key row of Kv.nvfp4 is that row and the 16-byte trailer (s_k, s_v, 8 zero bytes): 160 bytes; Kv.fp8_nvfp4 keeps
+//! the fp8 key rows (cuda_kv.zig) and writes its value row's R in their s_v. Every row is 16-byte aligned.
+//! The rule, on bf16 values held as floats (amax ignores NaN; absolute values, so -0.0 counts as 0):
+//!   R = 2^(ceil(log2 amax) - 11), its biased exponent held in 1..254 (exponentOf): amax / R lies in (1024, 2048];
+//!   a block's scale s is the smallest E4M3 value with 6 s >= bmax / R (bmax its largest magnitude): at most 352, so
+//!   no block scale saturates, and no code (|x| / R / s <= 6) does either; s is 0 for a zero block;
+//!   a value's code is |x| / R / s (one rounding, fp32) to the nearest of 0, 0.5, 1, 1.5, 2, 3, 4, 6, ties to the even
+//!   code, with x's sign bit (-0.0 keeps it); a zero block's codes are 0 with the sign.
+//! Reading one: code x (s x R), both products exact in fp32, then rounded to bf16, which is exact for R >= 2^-123
+//! (amax above 2^-113): a code has 2 significant bits and s has 4, so 6 at most fit bf16's 8. Rows above 2^127 may
+//! round their largest values up past fp32's range (to inf), as bf16's own rounding would. A NaN stores as a zero
+//! code; an infinity takes the top code under R = 2^117 and reads back as that infinity (6 x 448 x 2^117 overflows).
+//! The kernels (flashnext_attn.cu kv4_*) compute each step with the same IEEE operations; this file is their model.
+
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const kv = @import("cuda_kv.zig");
+
+/// Values a block scale covers, and a row's blocks.
+pub const block = 16;
+pub const blocks = wt.head_dim / block;
+/// Where a row's block scales start (after the codes, two a byte), and its bytes.
+pub const scales_at = wt.head_dim / 2;
+pub const row = scales_at + blocks;
+/// A Kv.nvfp4 key row: the row and cuda_kv.zig's trailer (s_k, s_v, 8 zero bytes).
+pub const key_stride = row + kv.key_trailer;
+/// R = 2^(ceil(log2 amax) - row_shift): 2048 / 6 rounds up to the E4M3 value 352, under its 448.
+pub const row_shift = 11;
+/// The E2M1 magnitudes by code.
+pub const grid = [8]f32{ 0, 0.5, 1, 1.5, 2, 3, 4, 6 };
+
+/// The E2M1 magnitude code of y >= 0 (at most 6): nearest, ties to the even code; NaN is 0.
+pub fn magnitude(y: f32) u8 {
+    var c: u8 = 0;
+    for ([_]f32{ 0.25, 1.25, 2.5, 5 }) |t| c += @intFromBool(y > t); // ties go down to the even code
+    for ([_]f32{ 0.75, 1.75, 3.5 }) |t| c += @intFromBool(y >= t); // ties go up to the even code
+    return c;
+}
+
+/// A code's value: its magnitude, negative with bit 3 (code 8 is -0.0).
+pub fn value(code: u8) f32 {
+    const m = grid[code & 7];
+    return if (code & 8 != 0) -m else m;
+}
+
+/// The E4M3 code of the smallest value s with 6 s >= a (a >= 0): the nearest code to a / 6, one up when it falls short,
+/// held at 448 (an infinite a only).
+pub fn blockCode(a: f32) u8 {
+    const c = kv.encode(a / 6.0);
+    return if (kv.decode(c) * 6.0 < a) @min(c + 1, 0x7E) else c;
+}
+
+/// A row of bf16 values (as floats) to its codes and block scales; returns R.
+pub fn quantizeRow(x: []const f32, out: []u8) f32 {
+    std.debug.assert(x.len == wt.head_dim and out.len == row);
+    var bmax: [blocks]f32 = @splat(0);
+    for (x, 0..) |v, i| {
+        if (@abs(v) > bmax[i / block]) bmax[i / block] = @abs(v); // fmaxf(|v|, 0): a NaN drops out
+    }
+    var amax: f32 = 0;
+    for (bmax) |m| amax = @max(amax, m);
+    const e = kv.exponentOf(amax, row_shift);
+    const inv: f32 = @bitCast((254 - e) << 23);
+    @memset(out[0..scales_at], 0);
+    for (0..blocks) |b| {
+        const c = blockCode(bmax[b] * inv);
+        out[scales_at + b] = c;
+        const s = kv.decode(c);
+        for (b * block..(b + 1) * block) |i| {
+            const y = if (s > 0) @abs(x[i]) * inv / s else 0;
+            const code = magnitude(y) | @as(u8, if (std.math.signbit(x[i])) 8 else 0);
+            out[i / 2] |= code << @intCast(4 * (i % 2));
+        }
+    }
+    return @bitCast(e << 23);
+}
+
+/// A row's codes, block scales and R to the bf16 values the attention tiles hold.
+pub fn dequantizeRow(r: []const u8, scale: f32, out: []f32) void {
+    std.debug.assert(r.len == row and out.len == wt.head_dim);
+    for (out, 0..) |*o, i| {
+        const code = (r[i / 2] >> @intCast(4 * (i % 2))) & 15;
+        o.* = kv.roundBf16(value(code) * (kv.decode(r[scales_at + i / block]) * scale));
+    }
+}
+
+// ---- tests -----------------------------------------------------------------------------------------------------
+
+const testing = std.testing;
+
+/// The E2M1 code nearest y (exact, in f64), the even code on a tie, by looking at every code.
+fn nearest(y: f64) u8 {
+    var best: u8 = 0;
+    for (1..8) |c| {
+        const gap = @abs(grid[c] - y);
+        const was = @abs(grid[best] - y);
+        if (gap < was or (gap == was and c % 2 == 0)) best = @intCast(c);
+    }
+    return best;
+}
+
+fn randomRow(r: std.Random, x: []f32, spread: f32) void {
+    for (x, 0..) |*v, i| {
+        const size = spread * std.math.ldexp(@as(f32, 1.0), -@as(i32, @intCast(i / block % 7)) * 2); // blocks of every size
+        v.* = kv.roundBf16((r.float(f32) * 2 - 1) * size);
+    }
+}
+
+test "NVFP4 rows: 144 bytes, 160 with the key trailer, both 16-byte aligned" {
+    try testing.expectEqual(@as(usize, 128), scales_at);
+    try testing.expectEqual(@as(usize, 144), row);
+    try testing.expectEqual(@as(usize, 160), key_stride);
+    try testing.expectEqual(@as(usize, 0), row % 16);
+    try testing.expectEqual(@as(usize, 0), key_stride % 16);
+}
+
+test "E2M1 codes: round to nearest even onto 0, 0.5, 1, 1.5, 2, 3, 4, 6" {
+    for (grid, 0..) |g, c| try testing.expectEqual(@as(u8, @intCast(c)), magnitude(g));
+    for (0..7) |c| { // midpoints go to the even code
+        const mid = (grid[c] + grid[c + 1]) / 2;
+        try testing.expectEqual(@as(u8, @intCast(if (c % 2 == 0) c else c + 1)), magnitude(mid));
+        try testing.expectEqual(@as(u8, @intCast(c)), magnitude(std.math.nextAfter(f32, mid, 0)));
+        try testing.expectEqual(@as(u8, @intCast(c + 1)), magnitude(std.math.nextAfter(f32, mid, 7)));
+    }
+    var y: f32 = 0;
+    while (y <= 6) : (y += 1.0 / 64.0) try testing.expectEqual(nearest(y), magnitude(y));
+    try testing.expectEqual(@as(u8, 0), magnitude(std.math.nan(f32)));
+    try testing.expectEqual(@as(f32, -6), value(15));
+    try testing.expect(std.math.signbit(value(8)) and value(8) == 0);
+}
+
+test "a block's scale is the smallest E4M3 value s with 6 s >= a, never past 352 under a row's 2048" {
+    var bits: u32 = 0x30000000; // 2^-31 to 2048 in steps across every binade
+    while (@as(f32, @bitCast(bits)) <= 2048) : (bits += 0x1F3F) {
+        const a: f32 = @bitCast(bits);
+        const c = blockCode(a);
+        try testing.expect(kv.decode(c) * 6 >= a);
+        if (c > 0) try testing.expect(kv.decode(c - 1) * 6 < a);
+    }
+    try testing.expectEqual(@as(f32, 352), kv.decode(blockCode(2048)));
+    try testing.expectEqual(@as(u8, 0), blockCode(0));
+    try testing.expectEqual(@as(u8, 1), blockCode(0x1p-40)); // a nonzero block never gets a zero scale
+    try testing.expectEqual(@as(u8, 0x7E), blockCode(std.math.inf(f32)));
+}
+
+test "a row: R puts its largest value in (1024, 2048], nothing saturates, codes are |x| / R / s to nearest even" {
+    var prng = std.Random.DefaultPrng.init(0x4e5646);
+    const r = prng.random();
+    var x: [wt.head_dim]f32 = undefined;
+    var q: [row]u8 = undefined;
+    var back: [wt.head_dim]f32 = undefined;
+    for (0..200) |trial| {
+        const spread = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(trial % 60)) - 30);
+        randomRow(r, &x, spread);
+        const s_row = quantizeRow(&x, &q);
+        var amax: f32 = 0;
+        for (x) |v| amax = @max(amax, @abs(v));
+        if (amax == 0) continue;
+        try testing.expect(amax / s_row > 1024 and amax / s_row <= 2048);
+        dequantizeRow(&q, s_row, &back);
+        for (x, back, 0..) |v, w, i| {
+            const s: f64 = kv.decode(q[scales_at + i / block]);
+            const y = @abs(@as(f64, v)) / s_row / s;
+            try testing.expect(y <= 6); // no saturation
+            const code = (q[i / 2] >> @intCast(4 * (i % 2))) & 15;
+            try testing.expectEqual(nearest(y), code & 7); // the exact quotient's nearest even code
+            try testing.expectEqual(std.math.signbit(v), code & 8 != 0);
+            // dequantized: the code's value times s and R, a bf16 value as is
+            try testing.expectEqual(@as(f64, value(code)) * s * s_row, @as(f64, w));
+            try testing.expectEqual(w, kv.roundBf16(w));
+        }
+    }
+}
+
+test "dequantizing is exact: every code times every block scale times R from 2^-123 to 2^116 is a bf16 value" {
+    var e: u32 = 4;
+    while (e <= 243) : (e += 1) {
+        const s_row: f32 = @bitCast(e << 23);
+        for (0..0x7F) |bc| {
+            const sc = kv.decode(@intCast(bc)) * s_row;
+            for (0..16) |c| {
+                const v = value(@intCast(c)) * sc;
+                try testing.expect(std.math.isFinite(v));
+                try testing.expectEqual(v, kv.roundBf16(v));
+                try testing.expectEqual(@as(f64, value(@intCast(c))) * kv.decode(@intCast(bc)) * s_row, @as(f64, v));
+            }
+        }
+    }
+}
+
+test "edge rows: zeros, -0.0, NaN, infinities, the tiniest and the largest magnitudes" {
+    var x: [wt.head_dim]f32 = @splat(0);
+    var q: [row]u8 = undefined;
+    var back: [wt.head_dim]f32 = undefined;
+    // a zero row: R = 2^-126, zero scales and codes; -0.0 keeps its sign bit
+    x[3] = -0.0;
+    try testing.expectEqual(@as(f32, 0x1p-126), quantizeRow(&x, &q));
+    for (q, 0..) |b, i| try testing.expectEqual(@as(u8, if (i == 1) 0x80 else 0), b);
+    dequantizeRow(&q, 0x1p-126, &back);
+    for (back, 0..) |v, i| try testing.expect(v == 0 and std.math.signbit(v) == (i == 3));
+    // a NaN stores as a zero code and drops out of the scales
+    x = @splat(0.75);
+    x[17] = std.math.nan(f32);
+    const s_nan = quantizeRow(&x, &q);
+    try testing.expectEqual(@as(f32, 0x1p-11), s_nan); // amax 0.75: ceil(log2) is 0
+    dequantizeRow(&q, s_nan, &back);
+    try testing.expectEqual(@as(f32, 0), back[17]);
+    try testing.expectEqual(@as(f32, 0.75), back[16]); // 0.75 / 2^-11 is 6 x 256: exact
+    // an infinity: R = 2^117, the top code and scale, and back to the same infinity; the row's finite values round to 0
+    x = @splat(1.0);
+    x[200] = -std.math.inf(f32);
+    const s_inf = quantizeRow(&x, &q);
+    try testing.expectEqual(@as(f32, 0x1p117), s_inf);
+    dequantizeRow(&q, s_inf, &back);
+    try testing.expectEqual(-std.math.inf(f32), back[200]);
+    try testing.expectEqual(@as(f32, 0), back[0]);
+    // the tiniest bf16 row (subnormal amax) still quantizes without saturation; R is held at 2^-126
+    x = @splat(0);
+    x[0] = 0x1p-133;
+    x[100] = -0x1p-130;
+    const s_tiny = quantizeRow(&x, &q);
+    try testing.expectEqual(@as(f32, 0x1p-126), s_tiny);
+    dequantizeRow(&q, s_tiny, &back);
+    try testing.expectEqual(@as(f32, 0x1p-133), back[0]); // 4 x 2^-9 x 2^-126
+    try testing.expect(back[100] < 0 and @abs(back[100] - x[100]) <= -x[100] / 6);
+    // a huge row under 2^127 reads back finite and within a code step
+    x = @splat(0);
+    x[0] = kv.roundBf16(0x1.fcp126);
+    x[1] = kv.roundBf16(0x1.3p120);
+    const s_huge = quantizeRow(&x, &q);
+    try testing.expectEqual(@as(f32, 0x1p116), s_huge);
+    dequantizeRow(&q, s_huge, &back);
+    try testing.expect(std.math.isFinite(back[0]) and @abs(back[0] - x[0]) <= x[0] / 6);
+}
+
+test "a row round trip: each value within half a code step of its block's scale" {
+    var prng = std.Random.DefaultPrng.init(0x6b7634);
+    const r = prng.random();
+    var x: [wt.head_dim]f32 = undefined;
+    var q: [row]u8 = undefined;
+    var back: [wt.head_dim]f32 = undefined;
+    for (0..64) |trial| {
+        randomRow(r, &x, std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(trial % 16)) - 8));
+        const s_row = quantizeRow(&x, &q);
+        dequantizeRow(&q, s_row, &back);
+        for (x, back, 0..) |a, b, i| {
+            const step = kv.decode(q[scales_at + i / block]) * s_row; // the grid's unit in this block
+            const half_step: f32 = if (@abs(a) < 2 * step) 0.25 * step else if (@abs(a) < 4 * step) 0.5 * step else step;
+            try testing.expect(@abs(a - b) <= half_step);
+        }
+    }
+}
