+
+/// One narrow format: the write, the reads (contiguous, paged, lanes), and the MTP head's bf16 glue beside it.
+fn format(r: *Rig, g: Glues, all: Pages) !void {
+    const pages = all.of(g.f.kv);
+    try prep(r, g, pages);
+    const c = try cache(r, g.f.kv);
+    try attention(r, g, c, pages, false);
+    try attention(r, g, c, pages, true);
+    try lanes(r, g, c);
+    const h = try g.f.withKv(.bf16); // the MTP head's: shares f's modules
+    try head(r, g.b, &h, pages, c);
+}
+
+/// `run` over TF_FLASHNEXT_KV4's rows: values (fp8 keys, NVFP4 values) and all (NVFP4 keys and values).
+pub fn runKv4(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(62);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var b = try flash.Glue.load(gpu.d);
+    defer b.deinit();
+    const pages = try Pages.init(&r);
+    for ([_]Kv{ .fp8_nvfp4, .nvfp4 }) |kv| {
+        var f = try flash.Glue.loadFor(gpu.d, kv);
+        defer f.deinit();
+        try format(&r, .{ .b = &b, .f = &f }, pages);
+    }
+    check.pass("flashnext-kv4: for fp8 keys with NVFP4 values and for NVFP4 keys and values, the quantizing write equals cuda_kv4.zig's model byte for byte; the widening reads equal the bf16 kernels on the dequantized rows, dense and sparse, chunked and fused; paged and one-launch lanes equal the contiguous launches; the MTP head's bf16 glue beside them is the bf16 glue's bytes", .{});
+}
