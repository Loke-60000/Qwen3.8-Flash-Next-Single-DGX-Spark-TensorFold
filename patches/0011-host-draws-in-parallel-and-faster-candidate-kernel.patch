--- /dev/null
+++ b/zig/src/families/flashnext/cuda_host_draw.zig
@@ -0,0 +1,210 @@
+//! Keyed draws on the host, several rows at once (TF_FLASHNEXT_HOST_DRAW_THREADS): each row's draw is its own.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const mtp = @import("cuda_mtp.zig");
+const cand = @import("cuda_mtp_cand.zig");
+const ple_pool = @import("cuda_ple_pool.zig");
+
+const unread = std.math.maxInt(u32);
+var configured: std.atomic.Value(u32) = .init(unread);
+
+/// Workers beside the engine thread at most.
+pub const max_threads: usize = 31;
+
+/// TF_FLASHNEXT_HOST_DRAW_THREADS (read once): workers beside the engine thread; 0, the default, draws on it alone.
+pub fn threads() usize {
+    var v = configured.load(.monotonic);
+    if (v == unread) {
+        const text = if (std.c.getenv("TF_FLASHNEXT_HOST_DRAW_THREADS")) |e| std.mem.span(e) else "0";
+        v = @intCast(@min(std.fmt.parseInt(u32, std.mem.trim(u8, text, " \t\r\n"), 10) catch 0, max_threads));
+        configured.store(v, .monotonic);
+    }
+    return v;
+}
+
+const max_k: usize = 256;
+/// Bytes of a worker's draw arrays at k = max_k (drawRow's and choose's), with room to spare.
+const scratch_bytes: usize = 32 * 1024;
+
+/// Whether a draw of `sm` over `n` scores fits a worker's scratch (a wider top_k draws on the engine thread).
+pub fn fits(sm: ?mtp.Sampling, n: usize) bool {
+    const s = sm orelse return true;
+    if (s.temperature <= 0) return true;
+    return (if (s.top_k == 0 or s.top_k >= n) n else @as(usize, s.top_k)) <= max_k;
+}
+
+/// One row's draw: the row (masked by `mask` first), its key and, for a draft pick, the token's probability.
+pub const Job = struct {
+    row: []u16,
+    ids: ?[]const u32 = null,
+    mask: []const u32 = &.{},
+    lse: f32 = 0,
+    position: u64,
+    sm: ?mtp.Sampling,
+    pick: bool = false,
+    token: u32 = 0,
+    prob: f64 = 0,
+    err: ?anyerror = null,
+
+    fn run(j: *Job) void {
+        var buf: [scratch_bytes]u8 align(16) = undefined;
+        var fba = std.heap.FixedBufferAllocator.init(&buf);
+        const a = fba.allocator();
+        if (j.mask.len > 0) mtp.maskRow(j.row, j.mask);
+        if (j.pick) {
+            const p = mtp.drawPick(a, j.row, j.ids.?, j.lse, j.position, j.sm) catch |e| {
+                j.err = e;
+                return;
+            };
+            j.token = p.token;
+            j.prob = p.prob;
+        } else j.token = mtp.drawRow(a, j.row, j.ids, j.position, j.sm) catch |e| {
+            j.err = e;
+            return;
+        };
+    }
+};
+
+const Batch = struct {
+    jobs: []Job,
+    parts: usize,
+
+    fn part(ctx: *const anyopaque, p: usize) anyerror!void {
+        const b: *const Batch = @ptrCast(@alignCast(ctx));
+        var i = p;
+        while (i < b.jobs.len) : (i += b.parts) b.jobs[i].run();
+    }
+};
+
+/// Every job drawn by the engine thread and up to threads() of `pool`'s workers; the first failed job's error.
+pub fn run(pool: ?*ple_pool.Pool, jobs: []Job) !void {
+    const b: Batch = .{ .jobs = jobs, .parts = @max(1, @min(jobs.len, threads() + 1)) };
+    if (b.parts == 1 or pool == null) try Batch.part(&b, 0) else try pool.?.run(b.parts, .{ .ctx = &b, .run = Batch.part });
+    for (jobs) |j| if (j.err) |e| return e;
+}
+
+fn download(stream: cuda.Stream, dst: []u8, src: u64) !void {
+    const d = stream.d;
+    try stream.synchronize();
+    try d.check(d.api.cuMemcpyDtoH_v2(dst.ptr, src, dst.len), "cuMemcpyDtoH");
+}
+
+/// Windows one call draws at most (a shared pass's).
+pub const max_windows: usize = 32;
+
+/// Ops.draws over a shared pass's windows (ds[i] by sms[i] in masks[i], into outs[i]), all device work queued first.
+pub fn windows(h: *const mtp.Head, st: cuda.Stream, gpa: std.mem.Allocator, pool: ?*ple_pool.Pool, ds: []const *mtp.Draft, sms: []const ?mtp.Sampling, masks: []const []const u32, outs: []const []u32) !void {
+    const vocab = wt.vocab;
+    if (ds.len > max_windows) return error.UnexpectedTensor;
+    // greedy windows' bests, then with TF_FLASHNEXT_SAMPLE_CAND=1 the sampled ones' candidates in slots side by side
+    var slot_at: [max_windows]usize = undefined;
+    var slot_k: [max_windows]usize = @splat(0);
+    var slots: usize = 0;
+    for (ds, sms, masks, 0..) |d, sm, mk, i| {
+        if (!mtp.isSampled(sm) and mk.len == 0) {
+            try h.best(st, d.logits.ptr, vocab, vocab, d.rows, d.best.ptr);
+        } else if (cand.candidatesOn() and mk.len == 0) if (cand.candidateCount(sm, vocab)) |count| if (slots + d.rows <= cand.cand_slots) {
+            try cand.launch(h, st, d.logits.ptr, vocab, vocab, d.rows, count, slots);
+            slot_at[i] = slots;
+            slot_k[i] = count;
+            slots += d.rows;
+        };
+    }
+    var c: cand.Cands = undefined;
+    if (slots > 0) try c.read(h, st);
+    // the rest read whole, drawn on the host's threads (rows past a worker's scratch or the jobs' room: here)
+    var jobs: [mtp.round_rows]Job = undefined;
+    var n_jobs: usize = 0;
+    var jobbed: [max_windows]bool = @splat(false);
+    for (ds, sms, masks, outs, 0..) |d, sm, mk, out, i| {
+        const n = d.rows;
+        if (!mtp.isSampled(sm) and mk.len == 0) {
+            try download(st, std.mem.sliceAsBytes(d.best_host[0 .. 4 * n]), d.best.ptr);
+            for (out[0..n], 0..) |*t, r| t.* = @intCast(@as(i32, @bitCast(d.best_host[4 * r + 2])));
+            continue;
+        }
+        if (slot_k[i] > 0 and std.mem.allEqual(i32, c.flags[slot_at[i]..][0..n], 0)) {
+            for (out[0..n], 0..) |*t, r| {
+                const at = (slot_at[i] + r) * cand.cand_max;
+                t.* = try cand.drawCandidates(gpa, c.vals[at..][0..slot_k[i]], c.cols[at..][0..slot_k[i]], null, d.fed0 + 1 + r, sm);
+            }
+            continue;
+        }
+        const rows = d.host[0 .. n * vocab];
+        try download(st, std.mem.sliceAsBytes(rows), d.logits.ptr);
+        const words = mk.len / n;
