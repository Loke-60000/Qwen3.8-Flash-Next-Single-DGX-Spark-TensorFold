+    var logits: [1]f64 = undefined;
+    var long: scoring.Ask = .{ .prompt = &.{ 1, 2, 3, 4, 5, 6 }, .labels = &.{7}, .logits = &logits };
+    var half: scoring.Ask = .{ .prompt = &.{ 1, 2, 3, 4 }, .labels = &.{7}, .logits = &logits };
+    try host.scores.asks.appendSlice(gpa, &.{ &long, &half });
+    Stepper.steps = 0;
+    Stepper.drops = 0;
+    scoring.answerWith(&host, 2);
+    try std.testing.expect(long.done and long.failed);
+    try std.testing.expect(!half.done and half.job.?.state != null);
+    try std.testing.expectEqual(@as(usize, 1), Stepper.steps); // the long one never stepped
+    scoring.close(&host);
+    try std.testing.expect(half.done and half.failed);
+    try std.testing.expectEqual(@as(usize, 1), Stepper.drops);
+}
+
+test "an identity past 0 fails on a backend that scores only in one call" {
+    const log_level = std.testing.log_level;
+    std.testing.log_level = .err;
+    defer std.testing.log_level = log_level;
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{}, 1, 0);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    const plain = target.backend();
+    var vt = plain.vtable.*;
+    vt.score = Scorer.score;
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(gpa, &cfg, .{ .ptr = plain.ptr, .vtable = &vt }, clock.clock());
+    defer core.deinit();
+    var host = LaneHost.init(gpa, std.testing.io, &core, .{ .lanes = 1 });
