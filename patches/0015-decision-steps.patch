+    defer host.stop();
+    var logits: [1]f64 = undefined;
+    try std.testing.expectError(error.Failed, host.engine().scoreAs(3, &.{1}, &.{2}, &logits, false));
+    _ = try host.engine().scoreAs(0, &.{1}, &.{2}, &logits, false);
+}
+
+test "score steps beside decoding streams take TENSORFOLD_DECISION_SHARE of the time at most" {
+    try std.testing.expectEqual(@as(i96, 900), scoring.owed(100, 0.1)); // 100 of every 1,000
+    try std.testing.expectEqual(@as(i96, 100), scoring.owed(100, 0.5));
