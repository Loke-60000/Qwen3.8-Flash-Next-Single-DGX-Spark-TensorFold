+
+/// A backend scoring in steps: each step feeds `job.rows` rows (0: the rest); done, label i scores the prompt's length
+/// plus i plus 100 times the identity, the mass 7.5.
+const Stepper = struct {
+    var drops: usize = 0;
+    var steps: usize = 0;
+
+    fn step(_: *anyopaque, job: *lanes.backend.ScoreJob) anyerror!bool {
+        steps += 1;
+        const left = job.prompt.len - job.fed;
+        job.fed += if (job.rows == 0) left else @min(left, job.rows);
+        job.state = @ptrFromInt(0x10); // a cache held between steps
+        if (job.fed < job.prompt.len) return false;
+        job.state = null;
+        for (job.logits, 0..) |*v, i| v.* = @floatFromInt(job.prompt.len + i + 100 * @as(usize, job.identity));
+        job.logsumexp = if (job.mass) 7.5 else 0;
+        return true;
+    }
+
+    fn drop(_: *anyopaque, job: *lanes.backend.ScoreJob) void {
+        drops += 1;
+        job.state = null;
+    }
+};
+
+fn stepperHost(gpa: std.mem.Allocator, cfg: *lanes.Config, target: *lanes.fake.Fake, vt: *lanes.backend.Backend.VTable, clock: *lanes.fake.FixedClock, core: *lanes.Engine) LaneHost {
+    const plain = target.backend();
+    vt.* = plain.vtable.*;
+    vt.score_step = Stepper.step;
+    vt.score_drop = Stepper.drop;
+    core.* = lanes.Engine.init(gpa, cfg, .{ .ptr = plain.ptr, .vtable = vt }, clock.clock());
+    return LaneHost.init(gpa, std.testing.io, core, .{ .lanes = 1 });
+}
+
+test "a score taken in steps feeds at most a round's rows, waits for the next round, and reads its identity" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{}, 1, 0);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var vt: lanes.backend.Backend.VTable = undefined;
+    var clock: lanes.fake.FixedClock = .{};
+    var core: lanes.Engine = undefined;
+    var host = stepperHost(gpa, &cfg, &target, &vt, &clock, &core);
+    defer core.deinit();
+    defer scoring.close(&host);
+    var logits: [2]f64 = undefined;
+    var ask: scoring.Ask = .{ .prompt = &.{ 1, 2, 3, 4, 5, 6, 7 }, .labels = &.{ 8, 9 }, .logits = &logits, .mass = true, .identity = 2 };
+    try host.scores.asks.append(gpa, &ask);
+    scoring.answerWith(&host, 3); // a round beside decoding streams: 3 rows
+    try std.testing.expect(!ask.done and ask.job.?.fed == 3);
+    scoring.answerWith(&host, 3);
+    try std.testing.expect(!ask.done and ask.job.?.fed == 6);
+    scoring.answerWith(&host, 3);
+    try std.testing.expect(ask.done and !ask.failed);
+    try std.testing.expectEqualSlices(f64, &.{ 207, 208 }, &logits);
+    try std.testing.expectEqual(@as(f64, 7.5), ask.logsumexp);
+    try std.testing.expectEqual(@as(usize, 0), host.scores.running.items.len);
+}
+
+test "scores share a round's rows oldest first, and with nothing decoding each runs to its end" {
+    const gpa = std.testing.allocator;
+    var cfg = try lanes.Config.init(gpa, .{}, 1, 0);
+    defer cfg.deinit(gpa);
+    var target: lanes.fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
