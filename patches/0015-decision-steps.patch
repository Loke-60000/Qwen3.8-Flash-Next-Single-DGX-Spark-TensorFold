+    try std.testing.expectEqualSlices(f64, &.{3}, &b_logits);
+}
+
+test "a score past TENSORFOLD_DECISION_MAX_TOKENS fails before a step, and a stop drops a score between steps" {
+    const log_level = std.testing.log_level;
