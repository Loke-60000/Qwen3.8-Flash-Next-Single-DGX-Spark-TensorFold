-pub fn headBytes(fp8: bool) usize {
+/// The built-in draft vocabulary's size, as headBytes has always counted it.
+pub const builtin_draft_rows: usize = 79_591;
+
+/// How many ids TF_FLASHNEXT_DRAFT_VOCAB gives the draft head (the built-in count when it cannot be read: the load
+/// that follows refuses that setting by name).
+pub fn draftRows(gpa: std.mem.Allocator, io: std.Io) usize {
+    const setting: ?[]const u8 = if (std.c.getenv("TF_FLASHNEXT_DRAFT_VOCAB")) |v| std.mem.span(v) else null;
+    if (setting == null or setting.?.len == 0) return builtin_draft_rows;
+    const ids = draftIdsFrom(gpa, io, setting) catch return builtin_draft_rows;
+    defer gpa.free(ids);
+    return ids.len;
+}
+
+/// Device bytes the head's weights take beyond the main model's; `fp8`: block-FP8 routed experts (headFp8); `draft_rows`:
+/// the draft vocabulary's ids (draftRows).
+pub fn headBytes(fp8: bool, draft_rows: usize) usize {
     const weights = 3 * wt.moe_w * dims;
     const nvfp4 = weights / 2 * 5 / 4;
     const routed = if (fp8) weights + 3 * (wt.moe_w / 128) * (dims / 128) * 4 else nvfp4;
     const experts = wt.experts_n * routed + nvfp4;
     const attn = (wt.proj_n + dims) * dims / 2 * 5 / 4;
-    const draft = 79_591 * dims / 2 * 5 / 4;
+    const draft = draft_rows * dims / 2 * 5 / 4;
     return experts + attn + draft + 2 * dims * dims / 2 * 5 / 4;
 }
 
