+/// TF_FLASHNEXT_DRAFT_VOCAB picks the ids the draft head can propose. Unset or empty: the built-in list, which covers
+/// English and code but leaves out a fifth of French tokens and most of Japanese. `all`: every id, at about three
+/// times the draft head's bytes a draft. A path: a file of ids in the built-in list's format. Drafts are only
+/// proposals the model checks, so replies are the same whichever list drafts them; only the drafts kept change.
+pub fn draftIdsFrom(gpa: std.mem.Allocator, io: std.Io, setting: ?[]const u8) ![]u32 {
+    const v = setting orelse return draftIds(gpa);
+    if (v.len == 0) return draftIds(gpa);
+    if (std.mem.eql(u8, v, "all")) {
+        const out = try gpa.alloc(u32, vocab);
+        for (out, 0..) |*id, i| id.* = @intCast(i);
+        return out;
+    }
+    const text = std.Io.Dir.cwd().readFileAlloc(io, v, gpa, .limited(1 << 26)) catch |e| {
+        std.log.warn("TF_FLASHNEXT_DRAFT_VOCAB={s}: {s}", .{ v, @errorName(e) });
+        return e;
+    };
+    defer gpa.free(text);
+    return proposal.legacy.ids(gpa, text, .{ .vocab = vocab, .delimiters = " \t\r\n," });
+}
