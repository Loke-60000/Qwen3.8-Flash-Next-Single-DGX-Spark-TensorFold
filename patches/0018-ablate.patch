diff --git a/zig/src/families/flashnext/cuda_ablate.zig b/zig/src/families/flashnext/cuda_ablate.zig
new file mode 100644
index 000000000..d077e06f3
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_ablate.zig
@@ -0,0 +1,171 @@
+//! Per-request abliteration: a baked W' = W - R diag(lam) R^T W's output y - R diag(lam) R^T y, on the rows that ask.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const wt = @import("cuda_prompt_wt.zig");
+const zs = @import("cuda_zero_slice.zig");
+
+const dims = wt.dims;
+const slots = wt.slots;
+
+pub const max_k = 4;
+
+/// TENSORFOLD_ABLATE's file: `directions` [k, dims] fp32 orthonormal, `lam_attn` and `lam_shared` [k], `first_layer`.
+pub const Ablation = struct {
+    /// [k * dims directions | k lam_attn | k lam_shared] fp32
+    dev: cuda.DeviceBuffer,
+    k: usize,
+    /// Layers below it are left alone; the MTP head always is (the main forward verifies its drafts).
+    first: usize,
+    /// The loaded floats and first layer, hashed: a disk state's identity takes it (cuda_disk.zig).
+    hash: u64,
+
+    /// lam_attn on a token mixer's output projection, lam_shared on the shared expert's down projection.
+    pub const Kind = enum { attn, shared };
+
+    /// The file TENSORFOLD_ABLATE names on the device, its strengths times TENSORFOLD_ABLATE_SCALE; null: unset.
+    pub fn fromEnv(gpa: std.mem.Allocator, io: std.Io, drv: *const cuda.Driver) !?Ablation {
+        const path = wanted() orelse return null;
+        const scale: f32 = if (env("TENSORFOLD_ABLATE_SCALE")) |v| std.fmt.parseFloat(f32, v) catch return error.BadAblateScale else 1;
+        if (!std.math.isFinite(scale)) return error.BadAblateScale;
+        var host: [max_k * dims + 2 * max_k]f32 = undefined;
+        const loaded = load(gpa, io, path, scale, &host) catch |err| {
+            std.log.err("ablation: {s}: {s}", .{ path, @errorName(err) });
+            return err;
+        };
+        const k = loaded.k;
+        const floats = host[0 .. k * dims + 2 * k];
+        var dev = try cuda.DeviceBuffer.fromHost(drv, std.mem.sliceAsBytes(floats));
+        errdefer dev.free();
+        std.log.info("ablation: {s}, {d} directions from layer {d}, lam_attn {any}, lam_shared {any} (scale {d})", .{ path, k, loaded.first, floats[k * dims ..][0..k], floats[k * dims + k ..][0..k], scale });
+        var h = std.hash.Wyhash.init(loaded.first);
+        h.update(std.mem.sliceAsBytes(floats));
+        return .{ .dev = dev, .k = k, .first = loaded.first, .hash = h.final() };
+    }
+
+    const Loaded = struct { k: usize, first: usize };
+
+    /// The file's directions, then lam_attn and lam_shared times `scale`, packed into `out`.
+    fn load(gpa: std.mem.Allocator, io: std.Io, path: []const u8, scale: f32, out: []f32) !Loaded {
+        var file = try core.safetensors.File.open(gpa, io, path);
+        defer file.close(io);
+        const dirs = file.get("directions") orelse return error.AblateFileMissesDirections;
+        if (dirs.dtype != .f32 or dirs.rank != 2 or dirs.shape[1] != dims) return error.AblateDirectionsShape;
+        const k = dirs.shape[0];
+        if (k < 1 or k > max_k) return error.AblateDirectionsShape;
+        const lam_attn = file.get("lam_attn") orelse return error.AblateFileMissesLambdas;
+        const lam_shared = file.get("lam_shared") orelse return error.AblateFileMissesLambdas;
+        if (!lam_attn.is(.f32, &.{k}) or !lam_shared.is(.f32, &.{k})) return error.AblateLambdaShape;
+        const first_t = file.get("first_layer") orelse return error.AblateFileMissesFirstLayer;
+        if (!first_t.is(.i64, &.{1})) return error.AblateFirstLayerShape;
+        const first = std.mem.readInt(i64, first_t.bytes[0..8], .little);
+        if (first < 0 or first >= wt.layers_n) return error.AblateFirstLayerShape;
+        // the mapped bytes may be unaligned: copied out before they are read as floats
+        @memcpy(std.mem.sliceAsBytes(out[0 .. k * dims]), dirs.bytes);
+        @memcpy(std.mem.sliceAsBytes(out[k * dims ..][0..k]), lam_attn.bytes);
+        @memcpy(std.mem.sliceAsBytes(out[k * dims + k ..][0..k]), lam_shared.bytes);
+        for (0..k) |a| for (0..k) |b| {
+            var dot: f64 = 0;
+            for (out[a * dims ..][0..dims], out[b * dims ..][0..dims]) |x, y| dot += @as(f64, x) * y;
+            const want: f64 = if (a == b) 1 else 0;
+            // written so a NaN fails it too
+            if (!(@abs(dot - want) <= 1e-3)) return error.AblateDirectionsNotOrthonormal;
+        };
+        for (out[k * dims ..][0 .. 2 * k]) |*l| {
+            if (!std.math.isFinite(l.*)) return error.AblateLambdaShape;
+            l.* *= scale;
+        }
+        return .{ .k = k, .first = @intCast(first) };
+    }
+
+    pub fn deinit(a: *Ablation) void {
+        a.dev.free();
+        a.* = undefined;
+    }
+
+    /// A writer's fp32 rows (`row_stride` apart, the sum of `slices` slices `slice_stride` apart) where `who` is set.
+    pub fn apply(a: *const Ablation, f: cuda.Function, stream: cuda.Stream, layer: usize, kind: Kind, y: u64, row_stride: usize, slice_stride: usize, slices: usize, who: u64, rows: usize) !void {
+        if (layer < a.first or rows == 0) return;
+        if (rows > 65535 or slices < 1 or row_stride < dims) return error.AblateRows;
+        const lam = a.dev.ptr + (a.k * dims + @as(usize, if (kind == .attn) 0 else a.k)) * 4;
+        var args: cuda.Args = .{};
+        args.add(y);
+        args.add(@as(c_longlong, @intCast(row_stride)));
+        args.add(@as(c_longlong, @intCast(slice_stride)));
+        args.add(@as(c_int, @intCast(slices)));
+        args.add(who);
+        args.add(a.dev.ptr);
+        args.add(lam);
+        args.add(@as(c_int, dims));
+        args.add(@as(c_int, @intCast(a.k)));
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, stream, &args);
+    }
+};
+
+/// TENSORFOLD_ABLATE's path; null: unset or empty.
+pub fn wanted() ?[]const u8 {
+    const v = std.mem.trim(u8, env("TENSORFOLD_ABLATE") orelse return null, " \t\r\n");
+    return if (v.len > 0) v else null;
+}
+
+/// Refused at load before anything is read: the correction runs on one rank (the shared expert's rank sum).
+pub fn check(tp: usize) !void {
+    if (tp != 1 and wanted() != null) return error.AblateNeedsOneRank;
+}
+
+/// Each row of a pass's `n` in the scratch's `who`: 1 where its lane's (or the lone sequence's) request asked.
+pub fn stage(pass: anytype, n: usize) !void {
+    if (pass.m.abl == null or !asked(pass)) return;
+    if (pass.lanes.len == 0) return fill(pass, 0, n, pass.seq.ablate);
+    var at: usize = 0;
+    for (pass.lanes) |l| {
+        try fill(pass, at, l.rows, l.seq.ablate);
+        at += l.rows;
+    }
+}
+
+/// The mixer's output in part, its K slices as the layer's write-back sums them, before that write-back.
+pub fn mixer(pass: anytype, layer: usize) !void {
+    const a = pass.m.abl orelse return;
+    if (!asked(pass)) return;
+    const s = pass.s;
+    const sl = zs.slices(pass.zero_slices, s.cap, pass.rows, pass.out_slices);
+    try a.apply(pass.k.ablate, pass.stream, layer, .attn, s.part, dims, sl.stride, sl.count, s.who, pass.rows);
+}
+
+/// The shared expert's output before the router's weight: y's last slot, or where a write-back reads it in place.
+pub fn shared(pass: anytype, layer: usize) !void {
+    const a = pass.m.abl orelse return;
+    if (!asked(pass)) return;
+    const s = pass.s;
+    // ponytail: shared_direct (patch 0016's in-place read, once ported) leaves y's slot unwritten
+    if (@hasField(@TypeOf(pass.*), "shared_direct") and pass.shared_direct) return a.apply(pass.k.ablate, pass.stream, layer, .shared, s.shared_out, dims, 0, 1, s.who, pass.rows);
+    try a.apply(pass.k.ablate, pass.stream, layer, .shared, s.y + (slots - 1) * dims * 4, slots * dims, 0, 1, s.who, pass.rows);
+}
+
+/// Whether some row of the pass asks; none: no fill, no launch, the stock pass's work alone.
+fn asked(pass: anytype) bool {
+    if (pass.lanes.len == 0) return pass.seq.ablate;
+    for (pass.lanes) |l| if (l.seq.ablate) return true;
+    return false;
+}
+
+fn fill(pass: anytype, at: usize, rows: usize, on: bool) !void {
+    const d = pass.stream.d;
+    try d.check(d.api.cuMemsetD32Async(pass.s.who + at * 4, @intFromBool(on), rows, pass.stream.handle), "cuMemsetD32Async");
+}
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+
+test "TENSORFOLD_ABLATE is refused at --tp 2 before anything loads, and an empty one is unset" {
+    const sys = @import("sys").env;
+    try check(2);
+    _ = sys.setenv("TENSORFOLD_ABLATE", "/a/skuld.safetensors", 1);
+    defer _ = sys.unsetenv("TENSORFOLD_ABLATE");
+    try std.testing.expectError(error.AblateNeedsOneRank, check(2));
+    try check(1);
+    _ = sys.setenv("TENSORFOLD_ABLATE", " ", 1);
+    try std.testing.expectEqual(@as(?[]const u8, null), wanted());
+}
