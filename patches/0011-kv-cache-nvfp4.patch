+    var y: f32 = 0;
+    while (y <= 6) : (y += 1.0 / 64.0) try testing.expectEqual(nearest(y), magnitude(y));
+    try testing.expectEqual(@as(u8, 0), magnitude(std.math.nan(f32)));
+    try testing.expectEqual(@as(f32, -6), value(15));
