+
+test "PLE shared gather: several streams in one call equal each stream's own call, rows and histories" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try fixture(tmp.dir, true);
+    const path = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(path);
+    var g = try ple.Ngram.init(a, io, path);
+    defer g.deinit();
+    // three streams, the same tokens in each after different histories (a table row shared across streams too)
+    const counts = [_]usize{ 1, 7, 40 };
+    var tokens: [48]u32 = undefined;
+    for (&tokens, 0..) |*v, i| v.* = @intCast((i * 5 + 1) % 23);
+    var want: [48 * 32]u16 = undefined;
+    var want_xs: [48]f32 = undefined;
+    var want_hist = [_][1]i64{ .{99}, .{4}, .{17} };
+    var got: [48 * 32]u16 = @splat(0xdead);
+    var got_xs: [48]f32 = undefined;
+    var got_hist = want_hist;
+    var parts: [3]ple.Part = undefined;
+    var at: usize = 0;
+    for (counts, 0..) |n, k| {
+        try g.rows(&want_hist[k], tokens[at..][0..n], want[at * 32 ..][0 .. n * 32], want_xs[at..][0..n]);
+        parts[k] = .{ .history = &got_hist[k], .rows = n };
+        at += n;
+    }
+    try g.rowsMany(&parts, &tokens, &got, &got_xs);
+    try std.testing.expectEqualSlices(u16, &want, &got);
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&want_xs), std.mem.sliceAsBytes(&got_xs));
+    for (want_hist, got_hist) |w, h| try std.testing.expectEqualSlices(i64, &w, &h);
+    // rows that do not add up to the tokens are refused before any history moves
+    parts[2].rows = 39;
+    try std.testing.expectError(error.UnexpectedTensor, g.rowsMany(&parts, &tokens, &got, &got_xs));
+    for (want_hist, got_hist) |w, h| try std.testing.expectEqualSlices(i64, &w, &h);
+}
