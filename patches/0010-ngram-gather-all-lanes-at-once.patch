index 92efda971..6dd03c7ed 100644
--- a/zig/src/families/flashnext/cuda_ple_nvfp4_test.zig
+++ b/zig/src/families/flashnext/cuda_ple_nvfp4_test.zig
@@ -172,3 +172,38 @@ test "PLE positional reads: mapped bytes, pool callers and short reads preserve
