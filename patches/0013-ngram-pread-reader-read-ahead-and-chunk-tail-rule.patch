index 5877ac7ce..e18f896ba 100644
--- a/zig/src/families/flashnext/cuda_chunk.zig
+++ b/zig/src/families/flashnext/cuda_chunk.zig
@@ -40,6 +40,43 @@ pub fn passRows(lanes: anytype, own: anytype, solo: usize, busy: usize) usize {
     return solo;
 }
 
+/// TF_FLASHNEXT_PREFILL_TAIL: a prompt's last chunk under this many rows is evened out with the one before (0: off).
+pub fn prefillTail() usize {
+    return std.fmt.parseInt(usize, std.mem.span(std.c.getenv("TF_FLASHNEXT_PREFILL_TAIL") orelse return 0), 10) catch 0;
+}
+
+/// The end of the chunk of `rows` from `at`, cut at the next cache mark; a last chunk under `tail` takes half the rest.
+pub fn planStop(rows: usize, total: usize, at: usize, marks: []const u32, tail: usize) usize {
+    var stop = @min(total, at + rows);
+    if (tail > 0 and stop < total and total - stop < tail) stop = at + @min(std.mem.alignForward(usize, (total - at + 1) / 2, 16), rows);
+    for (marks) |m| if (m > at and m < stop) return m;
+    return stop;
+}
+
+test "the tail rule evens out a short last chunk and leaves the rest alone" {
+    const plan = struct {
+        fn of(rows: usize, total: usize, marks: []const u32, tail: usize, out: []usize) []usize {
+            var at: usize = 0;
+            var n: usize = 0;
+            while (at < total) : (n += 1) {
+                const stop = planStop(rows, total, at, marks, tail);
+                out[n] = stop - at;
+                at = stop;
+            }
+            return out[0..n];
+        }
+    }.of;
+    var buf: [16]usize = undefined;
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 3072, 193 }, plan(3072, 12481, &.{}, 0, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 1648, 1617 }, plan(3072, 12481, &.{}, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072, 3072, 3072, 600 }, plan(3072, 12888, &.{}, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 3072 }, plan(3072, 6144, &.{}, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{100}, plan(3072, 100, &.{}, 512, &buf));
+    try std.testing.expectEqualSlices(usize, &.{ 3072, 1584, 1584 }, plan(3072, 6240, &.{}, 512, &buf));
+    // a cache mark still cuts a chunk, and the chunks after it are planned afresh
+    try std.testing.expectEqualSlices(usize, &.{ 1000, 3072, 1616, 1612 }, plan(3072, 7300, &.{1000}, 512, &buf));
+}
+
 test "TF_FLASHNEXT_CHUNK takes 1 to the largest measured pass and refuses the rest" {
     try std.testing.expectEqual(batch.default_chunk, try parseChunk(null));
     try std.testing.expectEqual(@as(usize, 4096), try parseChunk("4096"));
