+    g.direct = try direct.Reader.create(a, io, &paths, &shards, g.hash.starts[0..3], 8, 1, 2, 8);
+    var got: [257 * 32]u16 = undefined;
+    var got_xs: [257]f32 = undefined;
+    for (0..3) |_| {
+        var h = [_]i64{99};
+        @memset(&got, 0xdead);
+        try g.rows(&h, &tokens, &got, &got_xs);
+        try std.testing.expectEqualSlices(u16, &want, &got);
+        g.direct.?.prefetch(&.{ 0, 1, 2, 3, 4, 5, 6, 7 });
+    }
+}
+
+test "NVFP4 rows read by pread: a failed read leaves that row to the mapping and the others are still gathered" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try fixture(tmp.dir, true);
+    const path = try std.fmt.allocPrint(a, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer a.free(path);
+    var g = try ple.Ngram.init(a, io, path);
+    defer g.deinit();
+    var tokens: [257]u32 = undefined;
+    for (&tokens, 0..) |*v, i| v.* = @intCast((i * 5 + 2) % 100);
+    var want: [257 * 32]u16 = undefined;
+    var want_xs: [257]f32 = undefined;
+    var h0 = [_]i64{99};
+    try g.rows(&h0, &tokens, &want, &want_xs);
+    g.direct = try direct.open(&g, io);
+    // every read of shard 0 now starts past the end of the file and fails; shard 1's are good, the mapping untouched
+    g.direct.?.shards[0].codes_at = 1 << 40;
+    var got: [257 * 32]u16 = undefined;
+    var got_xs: [257]f32 = undefined;
