new file mode 100644
index 000000000..a596ca3ec
--- /dev/null
+++ b/zig/src/native/cuda_flashnext_kv8_test.zig
@@ -0,0 +1,63 @@
+//! Flash Next's --kv-cache fp8 at admission and in the memory plan, without a checkpoint, a driver or a GPU.
+const std = @import("std");
+const flashnext = @import("flashnext");
+const refusals = @import("cuda_refusal.zig");
+const options = @import("cuda_options.zig");
+const memory = @import("cuda_memory.zig");
+
+const F = flashnext.native;
+const Kv = flashnext.prompt.kv_format.Kv;
+const GiB: u64 = 1 << 30;
+/// The MTP head's draft vocabulary (draft_vocab_default.txt) and a pass's rows: only the head's small fixed buffers see them.
+const draft_ids = 79591;
+const chunk = 1536;
+const window = 262144;
+
+fn room(gib: f64) u64 {
+    return @intFromFloat(gib * @as(f64, @floatFromInt(GiB)));
+}
+
+/// A drafting stream's device bytes at the window, as cuda_lanes_load.zig counts them: its sequence and its head's.
+fn streamBytes(kv: Kv) u64 {
+    return flashnext.prompt.seqBytesFor(kv, window) + flashnext.mtp.Draft.bytes(kv, window, draft_ids, chunk);
+}
+
+test "Flash Next takes --kv-cache fp8 at family admission and its options carry the flag" {
+    const asked: @import("engine_api").Open = .{ .dir = "d", .model_type = F.model_type, .kv8 = true };
+    try std.testing.expect(refusals.family(F, asked) == null);
+    var opts: F.Options = .{ .context = 4096, .drafts = true };
+    var why: []const u8 = "";
+    try std.testing.expect(options.set(F, asked, &opts, &why));
+    try std.testing.expect(opts.kv8);
+    opts = .{ .context = 4096, .drafts = true };
+    try std.testing.expect(options.set(F, .{ .dir = "d", .model_type = F.model_type }, &opts, &why));
+    try std.testing.expect(!opts.kv8);
+}
+
+test "a stream's bytes at the window: 7.8 GiB in bf16, 4.6 GiB in fp8, the rest the same" {
+    const bf = streamBytes(.bf16);
+    const f8 = streamBytes(.fp8);
+    // 13 attention caches (12 layers and the head's) at 262,144 tokens save (2,048 - 1,056) bytes each
+    try std.testing.expectEqual(@as(u64, 13 * window * (2048 - 1056)), bf - f8);
+    try std.testing.expect(bf > 7 * GiB and bf < 8 * GiB);
+    try std.testing.expect(f8 > 4 * GiB and f8 < 5 * GiB);
+}
+
+test "the Spark's 24.36 GiB of sequence memory admits five full-window streams in fp8 where bf16 admits three" {
+    const bf = streamBytes(.bf16);
+    const f8 = streamBytes(.fp8);
+    try std.testing.expectEqual(@as(u32, 3), try memory.admit(room(24.36), bf, 0, 16, false));
+    try std.testing.expectEqual(@as(u32, 5), try memory.admit(room(24.36), f8, 0, 16, false));
+    // five at once is refused in bf16 as a fixed count, and admitted in fp8
+    try std.testing.expectError(error.TooMany, memory.admit(room(24.36), bf, 0, 5, true));
+    try std.testing.expectEqual(@as(u32, 5), try memory.admit(room(24.36), f8, 0, 5, true));
+}
+
+test "the prompt cache keeps about 1.6 times the states in fp8" {
+    // 16 GiB of kept states of 32,768 tokens, each with the head's rows
+    const at = 32768;
+    const bf = flashnext.snap.bytes(.bf16, at, true);
+    const f8 = flashnext.snap.bytes(.fp8, at, true);
+    try std.testing.expectEqual(@as(usize, 13 * at * (2048 - 1056)), bf - f8);
+    try std.testing.expect(16 * GiB / f8 * 10 >= 16 * GiB / bf * 15);
+}
diff --git a/zig/tests/cuda/flashnext_kv8_tests.zig b/zig/tests/cuda/flashnext_kv8_tests.zig
new file mode 100644
index 000000000..7a503d28c
--- /dev/null
+++ b/zig/tests/cuda/flashnext_kv8_tests.zig
@@ -0,0 +1,340 @@
+//! --kv-cache fp8 on the device: the quantizing write (fn_attn_prep_kv8) against cuda_kv.zig's model of the format, the
+//! widening reads (fn_attn_chunks_one_kv8, fn_attn_fused_kv8) against the bf16 kernels run on the dequantized rows, and the
+//! paged (TF_FLASHNEXT_KV_PAGES) and one-launch lanes (TF_FLASHNEXT_ATTN_LANES) forms against the contiguous fp8 ones,
+//! byte for byte.
+const std = @import("std");
+const cuda = @import("cuda");
+const flash = @import("flashnext");
+const check = @import("check.zig");
+const rig = @import("flashnext_rig.zig");
+
+const kvf = flash.prompt.kv_format;
+const Rig = rig.Rig;
+const bf = rig.bf;
+
+const q_heads = 24;
+const kv_heads = 2;
+const head_dim = 256;
+const index_heads = 4;
+const index_dim = 128;
+const half = 32;
+const proj_n = 13952;
+const eps: f32 = 1e-6;
+const cap = 3072;
+const idw = 2052;
+const nch = 5;
+const key_stride = kvf.key_stride;
+const key_row = kvf.Kv.fp8.keyRow();
+const value_row = kvf.Kv.fp8.valueRow();
+/// The paged checks' positions a page: no 512-key chunk divides it.
+const ptok = 48;
+const page_bytes = ptok * (key_row + value_row + index_dim * 2) + ptok / 4 * index_dim * 2;
+
+/// Both formats' glue: the fp8 one launches the _kv8 kernels in the bf16 ones' place.
+const Glues = struct { b: *const flash.Glue, f: *const flash.Glue };
+
+fn inverse(r: *Rig) ![]f32 {
+    const inv = try r.a.alloc(f32, half);
+    for (inv, 0..) |*o, i| o.* = @floatCast(std.math.pow(f64, 10_000_000.0, -@as(f64, @floatFromInt(i)) / half));
+    return inv;
+}
+
+fn f32of(h: u16) f32 {
+    return @floatCast(bf(h));
+}
+
+/// Reversed pages of `ptok` positions for `cap` positions: the device table and the host ids.
+const Pages = struct {
+    ids: []i32,
+    table: u64,
+
+    fn init(r: *Rig) !Pages {
+        const ids = try r.a.alloc(i32, cap / ptok);
+        for (ids, 0..) |*id, i| id.* = @intCast(ids.len - 1 - i);
+        return .{ .ids = ids, .table = try r.dev(std.mem.sliceAsBytes(ids)) };
+    }
+
+    fn pg(p: Pages) flash.Pg {
+        return .{ .pt = p.table, .ps = page_bytes / 2, .ptok = ptok };
+    }
+
+    /// Byte offset of position `pos`'s row of `row` bytes in a page part starting `part` bytes into the page.
+    fn at(p: Pages, pos: usize, part: usize, row: usize) usize {
+        return @as(usize, @intCast(p.ids[pos / ptok])) * page_bytes + part + pos % ptok * row;
+    }
+};
+
+/// The write: the bf16 kernel's key and value rows through the model must be the fp8 kernel's bytes, and everything else it writes
+/// (queries, indexer queries and keys) the bf16 kernel's bytes; the paged write the contiguous one's rows.
+fn prep(r: *Rig, g: Glues, pages: Pages) !void {
+    const rows = 17;
+    const pos0 = 700;
+    const p = r.bfs(rows * proj_n, 2);
+    // row 1's values are all zero (a zero row: scale 2^-126, zero codes)
+    const v_at = q_heads * 2 * head_dim + kv_heads * head_dim;
+    @memset(p[proj_n + v_at ..][0 .. kv_heads * head_dim], 0);
+    const qw = r.f32s(head_dim, 0.5, 1.5);
+    const kw = r.f32s(head_dim, 0.5, 1.5);
+    const iw = r.f32s(index_dim, 0.5, 1.5);
+    const inv = try inverse(r);
+    const dp = try r.dev(std.mem.sliceAsBytes(p));
+    const dpos = try r.dev(std.mem.sliceAsBytes(&[_]i32{ pos0, 0, 0, 0 }));
+    const dqw = try r.dev(std.mem.sliceAsBytes(qw));
+    const dkw = try r.dev(std.mem.sliceAsBytes(kw));
+    const diw = try r.dev(std.mem.sliceAsBytes(iw));
+    const dinv = try r.dev(std.mem.sliceAsBytes(inv));
+    // bf16 caches, then fp8 ones
+    const q_b = try r.out(rows * q_heads * head_dim * 2);
+    const iq_b = try r.out(rows * index_heads * index_dim * 2);
+    const kc_b = try r.out(cap * kv_heads * head_dim * 2);
+    const vc_b = try r.out(cap * kv_heads * head_dim * 2);
+    const ikc_b = try r.out(cap * index_dim * 2);
+    try g.b.attnPrep(r.s, dp, dpos, dqw, dkw, diw, dinv, q_b, kc_b, vc_b, iq_b, ikc_b, eps, rows, .{});
+    const q_8 = try r.out(rows * q_heads * head_dim * 2);
+    const iq_8 = try r.out(rows * index_heads * index_dim * 2);
+    const kc_8 = try r.out(cap * key_row);
+    const vc_8 = try r.out(cap * value_row);
+    const ikc_8 = try r.out(cap * index_dim * 2);
+    try g.f.attnPrep(r.s, dp, dpos, dqw, dkw, diw, dinv, q_8, kc_8, vc_8, iq_8, ikc_8, eps, rows, .{});
+
+    try r.sameRows("fp8 prep queries", u16, q_8, try r.back(u16, q_b, rows * q_heads * head_dim));
+    try r.sameRows("fp8 prep indexer queries", u16, iq_8, try r.back(u16, iq_b, rows * index_heads * index_dim));
+    try r.sameRows("fp8 prep indexer keys", u16, ikc_8 + pos0 * index_dim * 2, (try r.back(u16, ikc_b, cap * index_dim))[pos0 * index_dim ..][0 .. rows * index_dim]);
+
+    const kb = try r.back(u16, kc_b, cap * kv_heads * head_dim);
+    const vb = try r.back(u16, vc_b, cap * kv_heads * head_dim);
+    const k8 = try r.back(u8, kc_8, cap * key_row);
+    const v8 = try r.back(u8, vc_8, cap * value_row);
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    var want_k: [key_stride]u8 = undefined;
+    var want_v: [head_dim]u8 = undefined;
+    for (0..rows) |row| for (0..kv_heads) |h| {
+        const slot = kvf.slotOf(pos0 + row, h);
+        for (&k, &v, 0..) |*a, *b, d| {
+            a.* = f32of(kb[slot * head_dim + d]);
+            b.* = f32of(vb[slot * head_dim + d]);
+        }
+        kvf.packRows(&k, &v, &want_k, &want_v);
+        try check.sameBytes("fp8 prep key row (codes, scales, zero tail)", k8[kvf.keyRowAt(slot)..][0..key_stride], &want_k);
+        try check.sameBytes("fp8 prep value row", v8[kvf.valueRowAt(slot)..][0..head_dim], &want_v);
+    };
+    // positions the launch did not write stay as filled
+    try check.expect(k8[kvf.keyRowAt(kvf.slotOf(pos0 - 1, 1))] == 0xff and v8[kvf.valueRowAt(kvf.slotOf(pos0 + rows, 0))] == 0xff, "fp8 prep writes only its rows' positions", .{});
+    // the zero value row of row 1: zero codes and the smallest scale
+    const zero_slot = kvf.slotOf(pos0 + 1, 0);
+    for (v8[kvf.valueRowAt(zero_slot)..][0..head_dim]) |c| try check.expect(c == 0, "a zero value row has zero codes", .{});
+    const sv: f32 = @bitCast(std.mem.readInt(u32, k8[kvf.keyRowAt(zero_slot) + kvf.value_scale_at ..][0..4], .little));
+    try check.expect(sv == 0x1p-126, "a zero value row's scale is 2^-126", .{});
+
+    // the paged write: each position's rows where its page keeps them, the same bytes
+    const arena = try r.out(pages.ids.len * page_bytes);
+    const q_p = try r.out(rows * q_heads * head_dim * 2);
+    const iq_p = try r.out(rows * index_heads * index_dim * 2);
+    try g.f.attnPrep(r.s, dp, dpos, dqw, dkw, diw, dinv, q_p, arena, arena + ptok * key_row, iq_p, arena + ptok * (key_row + value_row), eps, rows, pages.pg());
+    try r.sameRows("fp8 paged prep queries", u16, q_p, try r.back(u16, q_8, rows * q_heads * head_dim));
+    const paged = try r.back(u8, arena, pages.ids.len * page_bytes);
+    for (pos0..pos0 + rows) |pos| {
+        try check.sameBytes("fp8 paged prep key rows", paged[pages.at(pos, 0, key_row)..][0..key_row], k8[pos * key_row ..][0..key_row]);
+        try check.sameBytes("fp8 paged prep value rows", paged[pages.at(pos, ptok * key_row, value_row)..][0..value_row], v8[pos * value_row ..][0..value_row]);
+    }
+}
+
+/// A cache's rows of bf16 values, each row of a different size, as the format's bytes (kc8, vc8) and the bf16 rows they dequantize to.
+const Cache = struct {
+    kc8: []u8,
+    vc8: []u8,
+    kcd: []u16,
+    vcd: []u16,
+};
+
+fn cache(r: *Rig) !Cache {
+    const slots = cap * kv_heads;
+    const c: Cache = .{
+        .kc8 = try r.a.alloc(u8, slots * key_stride),
+        .vc8 = try r.a.alloc(u8, slots * head_dim),
+        .kcd = try r.a.alloc(u16, slots * head_dim),
+        .vcd = try r.a.alloc(u16, slots * head_dim),
+    };
+    var k: [head_dim]f32 = undefined;
+    var v: [head_dim]f32 = undefined;
+    var back: [head_dim]f32 = undefined;
+    for (0..slots) |slot| {
+        const size = std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(slot * 7 % 9)) - 4);
+        for (&k, &v) |*a, *b| {
+            a.* = @floatCast(bf(rig.bf16(@floatCast((r.rng.float(f32) * 2 - 1) * size))));
+            b.* = @floatCast(bf(rig.bf16(@floatCast((r.rng.float(f32) * 2 - 1) * size * 0.5))));
+        }
+        const kr = c.kc8[slot * key_stride ..][0..key_stride];
+        const vr = c.vc8[slot * head_dim ..][0..head_dim];
+        kvf.packRows(&k, &v, kr, vr);
+        kvf.dequantizeRow(kr[0..head_dim], @bitCast(std.mem.readInt(u32, kr[kvf.key_scale_at..][0..4], .little)), &back);
+        for (back, c.kcd[slot * head_dim ..][0..head_dim]) |a, *o| o.* = rig.bf16(a);
+        kvf.dequantizeRow(vr, @bitCast(std.mem.readInt(u32, kr[kvf.value_scale_at..][0..4], .little)), &back);
+        for (back, c.vcd[slot * head_dim ..][0..head_dim]) |a, *o| o.* = rig.bf16(a);
+    }
+    return c;
+}
+
+/// `rows` rows from `pos0`: their key lists (sparse: the indexer's picks; dense: every key) as attention takes them.
+const Rows = struct { ids: u64, nk: u64, spr: u64 };
+
+fn rowsOf(r: *Rig, pos0: usize, rows: usize, sparse: bool) !Rows {
+    const ids = try r.a.alloc(i32, rows * idw);
+    const nk = try r.a.alloc(i32, rows);
+    const spr = try r.a.alloc(i32, rows);
+    for (0..rows) |row| {
+        nk[row] = @intCast(if (sparse) idw - 1 - row % 3 else pos0 + row + 1);
+        spr[row] = @intFromBool(sparse);
+        for (0..idw) |i| ids[row * idw + i] = @intCast((i * 1237 + row * 31) % (pos0 + row + 1));
+    }
+    return .{ .ids = try r.dev(std.mem.sliceAsBytes(ids)), .nk = try r.dev(std.mem.sliceAsBytes(nk)), .spr = try r.dev(std.mem.sliceAsBytes(spr)) };
+}
+
+/// The read: the fp8 kernels over the codes against the bf16 kernels over the dequantized rows, dense and sparse, 1, 3 and 20 rows
+/// (the bf16 side reads ahead for up to 16 rows, one tile at a time past that), and the fused prompt launch; then the paged fp8
+/// launches against the contiguous fp8 ones.
+fn attention(r: *Rig, g: Glues, c: Cache, pages: Pages, sparse: bool) !void {
+    const counts = [_]usize{ 1, 3, 20 };
+    const rows = counts[counts.len - 1];
+    const pos0: usize = if (sparse) 2600 else 1100;
+    const q = r.bfs(rows * q_heads * head_dim, 1);
+    const sel = try rowsOf(r, pos0, rows, sparse);
+    const dq = try r.dev(std.mem.sliceAsBytes(q));
+    const dkc8 = try r.dev(c.kc8);
+    const dvc8 = try r.dev(c.vc8);
+    const dkcd = try r.dev(std.mem.sliceAsBytes(c.kcd));
+    const dvcd = try r.dev(std.mem.sliceAsBytes(c.vcd));
+    const dpos = try r.dev(std.mem.sliceAsBytes(&[_]i32{ @intCast(pos0), 0, 0, 0 }));
+    // the same rows on reversed pages
+    const host = try r.a.alloc(u8, pages.ids.len * page_bytes);
+    @memset(host, 0xff);
+    for (0..cap) |pos| {
+        @memcpy(host[pages.at(pos, 0, key_row)..][0..key_row], c.kc8[pos * key_row ..][0..key_row]);
+        @memcpy(host[pages.at(pos, ptok * key_row, value_row)..][0..value_row], c.vc8[pos * value_row ..][0..value_row]);
+    }
+    const arena = try r.dev(host);
+    const po = try r.out(rows * nch * q_heads * head_dim * 4);
+    const pm = try r.out(rows * nch * q_heads * 4);
+    const pl = try r.out(rows * nch * q_heads * 4);
+    const name = if (sparse) "fp8 attention sparse" else "fp8 attention dense";
+    const paged_name = if (sparse) "fp8 paged attention sparse" else "fp8 paged attention dense";
+    for (counts) |m| {
+        const chunks = if (sparse) (idw + 511) / 512 else (pos0 + m + 511) / 512;
+        const want = try r.out(m * q_heads * head_dim * 2);
+        try g.b.attnChunks(r.s, dq, dkcd, dvcd, dpos, po, pm, pl, sel.ids, sel.nk, sel.spr, m, kv_heads, chunks, true, .{});
+        try g.b.attnMerge(r.s, po, pm, pl, dpos, want, sel.nk, sel.spr, m, kv_heads, true);
+        const got = try r.out(m * q_heads * head_dim * 2);
+        try g.f.attnChunks(r.s, dq, dkc8, dvc8, dpos, po, pm, pl, sel.ids, sel.nk, sel.spr, m, kv_heads, chunks, true, .{});
+        try g.f.attnMerge(r.s, po, pm, pl, dpos, got, sel.nk, sel.spr, m, kv_heads, true);
+        const fp8 = try r.back(u16, got, m * q_heads * head_dim);
+        try r.sameRows(name, u16, want, fp8);
+        const paged = try r.out(m * q_heads * head_dim * 2);
+        try g.f.attnChunks(r.s, dq, arena, arena + ptok * key_row, dpos, po, pm, pl, sel.ids, sel.nk, sel.spr, m, kv_heads, chunks, true, pages.pg());
+        try g.f.attnMerge(r.s, po, pm, pl, dpos, paged, sel.nk, sel.spr, m, kv_heads, true);
+        try r.sameRows(paged_name, u16, paged, fp8);
+    }
+    const want = try r.out(rows * q_heads * head_dim * 2);
+    try g.b.attnFused(r.s, dq, dkcd, dvcd, dpos, want, sel.ids, sel.nk, sel.spr, rows, kv_heads, .{});
+    const got = try r.out(rows * q_heads * head_dim * 2);
+    try g.f.attnFused(r.s, dq, dkc8, dvc8, dpos, got, sel.ids, sel.nk, sel.spr, rows, kv_heads, .{});
+    const fp8 = try r.back(u16, got, rows * q_heads * head_dim);
+    try r.sameRows(if (sparse) "fp8 attention sparse fused" else "fp8 attention dense fused", u16, want, fp8);
+    const paged = try r.out(rows * q_heads * head_dim * 2);
+    try g.f.attnFused(r.s, dq, arena, arena + ptok * key_row, dpos, paged, sel.ids, sel.nk, sel.spr, rows, kv_heads, pages.pg());
+    try r.sameRows(if (sparse) "fp8 paged attention sparse fused" else "fp8 paged attention dense fused", u16, paged, fp8);
+}
+
+/// A shared round's two lanes (a dense and a sparse stream) in one launch a kernel against a launch a lane: the prep's rows
+/// and the attention's outputs, byte for byte.
+fn lanes(r: *Rig, g: Glues, c: Cache) !void {
+    const lane_pos = [2]usize{ 1100, 2600 };
+    const lane_rows = [2]usize{ 3, 5 };
+    const rows = lane_rows[0] + lane_rows[1];
+    const p = r.bfs(rows * proj_n, 2);
+    const dp = try r.dev(std.mem.sliceAsBytes(p));
+    const dqw = try r.dev(std.mem.sliceAsBytes(r.f32s(head_dim, 0.5, 1.5)));
+    const dkw = try r.dev(std.mem.sliceAsBytes(r.f32s(head_dim, 0.5, 1.5)));
+    const diw = try r.dev(std.mem.sliceAsBytes(r.f32s(index_dim, 0.5, 1.5)));
+    const dinv = try r.dev(std.mem.sliceAsBytes(try inverse(r)));
+    const dpos = try r.dev(std.mem.sliceAsBytes(&[_]i32{ @intCast(lane_pos[0]), 0, 0, 0, @intCast(lane_pos[1]), 0, 0, 0 }));
+    // each lane's caches twice: the one-launch round's and the per-lane reference's, both from the same rows
+    var caches: [2][2][4]u64 = undefined; // [launch][lane][k, v, indexer k, pooled]
+    for (&caches) |*launch| for (launch) |*l| {
+        l.* = .{ try r.dev(c.kc8), try r.dev(c.vc8), try r.out(cap * index_dim * 2), try r.out(cap / 4 * index_dim * 2) };
+    };
+    const tab = try r.a.alloc(u8, flash.batch_state.lanes_bytes);
+    @memset(tab, 0);
+    var row0: usize = 0;
+    for (0..2) |i| {
+        flash.batch_lanes.putCaches(tab, 0, i, caches[0][i][0], caches[0][i][1], caches[0][i][2], caches[0][i][3]);
+        flash.batch_lanes.putLane(tab, i, row0, lane_pos[i], lane_rows[i]);
+        row0 += lane_rows[i];
+    }
+    const dtab = try r.dev(tab);
+    const li = dtab + flash.batch_state.lanes_ptrs;
+    const q_l = try r.out(rows * q_heads * head_dim * 2);
+    const iq_l = try r.out(rows * index_heads * index_dim * 2);
+    try g.f.attnPrepLanes(r.s, dp, dtab, li, dqw, dkw, diw, dinv, q_l, iq_l, eps, rows);
+    const q_1 = try r.out(rows * q_heads * head_dim * 2);
+    const iq_1 = try r.out(rows * index_heads * index_dim * 2);
+    row0 = 0;
+    for (0..2) |i| {
+        const x = caches[1][i];
+        try g.f.attnPrep(r.s, dp + row0 * proj_n * 2, dpos + 16 * i, dqw, dkw, diw, dinv, q_1 + row0 * q_heads * head_dim * 2, x[0], x[1], iq_1 + row0 * index_heads * index_dim * 2, x[2], eps, lane_rows[i], .{});
+        row0 += lane_rows[i];
+    }
+    try r.sameRows("fp8 lanes prep queries", u16, q_l, try r.back(u16, q_1, rows * q_heads * head_dim));
+    try r.sameRows("fp8 lanes prep indexer queries", u16, iq_l, try r.back(u16, iq_1, rows * index_heads * index_dim));
+    for (0..2) |i| {
+        try r.sameRows("fp8 lanes prep key rows", u8, caches[0][i][0], try r.back(u8, caches[1][i][0], cap * key_row));
+        try r.sameRows("fp8 lanes prep value rows", u8, caches[0][i][1], try r.back(u8, caches[1][i][1], cap * value_row));
+    }
+    // attention over each lane's keys: the dense lane's every key, the sparse lane's picks
+    const a = try rowsOf(r, lane_pos[0], lane_rows[0], false);
+    const b = try rowsOf(r, lane_pos[1], lane_rows[1], true);
+    const ids = try r.out(rows * idw * 4);
+    const nk = try r.out(rows * 4);
+    const spr = try r.out(rows * 4);
+    for ([_]Rows{ a, b }, [_]usize{ 0, lane_rows[0] }, lane_rows) |x, at, n| {
+        for ([_][2]u64{ .{ ids, x.ids }, .{ nk, x.nk }, .{ spr, x.spr } }, [_]usize{ idw * 4, 4, 4 }) |pair, w| {
+            try r.gpu.d.check(r.gpu.d.api.cuMemcpyDtoDAsync_v2(pair[0] + at * w, pair[1], n * w, r.s.handle), "cuMemcpyDtoDAsync");
+        }
+    }
+    const po = try r.out(rows * nch * q_heads * head_dim * 4);
+    const pm = try r.out(rows * nch * q_heads * 4);
+    const pl = try r.out(rows * nch * q_heads * 4);
+    const got = try r.out(rows * q_heads * head_dim * 2);
+    try g.f.attnChunksLanes(r.s, q_l, dtab, li, po, pm, pl, ids, nk, spr, rows, kv_heads, nch);
+    try g.f.attnMergeLanes(r.s, po, pm, pl, li, got, nk, spr, rows, kv_heads);
+    const want = try r.out(rows * q_heads * head_dim * 2);
+    row0 = 0;
+    for (0..2) |i| {
+        const x = caches[1][i];
+        const q = q_l + row0 * q_heads * head_dim * 2;
+        try g.f.attnChunks(r.s, q, x[0], x[1], dpos + 16 * i, po, pm, pl, ids + row0 * idw * 4, nk + row0 * 4, spr + row0 * 4, lane_rows[i], kv_heads, nch, true, .{});
+        try g.f.attnMerge(r.s, po, pm, pl, dpos + 16 * i, want + row0 * q_heads * head_dim * 2, nk + row0 * 4, spr + row0 * 4, lane_rows[i], kv_heads, true);
+        row0 += lane_rows[i];
+    }
+    try r.sameRows("fp8 lanes attention", u16, got, try r.back(u16, want, rows * q_heads * head_dim));
+}
+
+pub fn run(gpu: check.Gpu) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(61);
+    var r = try Rig.init(gpu, arena.allocator(), prng.random());
+    defer r.deinit();
+    var b = try flash.Glue.load(gpu.d);
+    defer b.deinit();
+    var f = try flash.Glue.loadFor(gpu.d, .fp8);
+    defer f.deinit();
+    const g: Glues = .{ .b = &b, .f = &f };
+    const pages = try Pages.init(&r);
+    try prep(&r, g, pages);
+    const c = try cache(&r);
+    try attention(&r, g, c, pages, false);
+    try attention(&r, g, c, pages, true);
+    try lanes(&r, g, c);
+    check.pass("flashnext-kv8: the quantizing write equals the format's model byte for byte; the widening reads equal the bf16 kernels on the dequantized rows, dense and sparse, chunked and fused; paged and one-launch lanes equal the contiguous fp8 launches", .{});
+}
